{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 2; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 2; }; exec \"$p\" \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/pretooluse.py\"",
        "timeout": 60
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 2; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 2; }; exec \"$p\" \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/posttooluse.py\"",
        "timeout": 60
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 2; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 2; }; exec \"$p\" \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/posttooluse.py\"",
        "timeout": 60
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/precompact.py\"",
        "timeout": 60
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "matcher": "compact|clear|resume",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/sessionstart.py\"",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/stop.py\"",
        "timeout": 60
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/subagentstop.py\"",
        "timeout": 60
      }
    ]
  }
}
