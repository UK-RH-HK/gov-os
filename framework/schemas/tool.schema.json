{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/tool.schema.json",
  "title": "tool",
  "x-schema-version": "1.2.0",
  "type": "object",
  "properties": {
    "tool_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "MCP",
        "CLI",
        "API",
        "library"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "credential_scope": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "retired",
        "proposed"
      ]
    },
    "version": {
      "type": "string"
    },
    "version_pin": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "security_review": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_review": {
      "type": "string"
    },
    "installed_by": {
      "type": "string"
    },
    "health_check": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_exit": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "approved_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reversible": {
      "type": "boolean"
    },
    "cost_usd": {
      "type": "number"
    },
    "required_permission_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "READ_REPO",
          "WRITE_REPO_SCOPED",
          "RUN_TESTS",
          "NETWORK_READ",
          "NETWORK_WRITE",
          "PACKAGE_INSTALL",
          "SYSTEM_INSTALL",
          "DB_READ",
          "DB_WRITE",
          "CLOUD_READ",
          "CLOUD_WRITE",
          "CI_TRIGGER",
          "SECRET_READ",
          "DEPLOY_STAGING",
          "DEPLOY_PRODUCTION"
        ]
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_review_record": {
      "type": "string",
      "description": "id of the governed record (decision/research/report) evidencing the security review; a descriptor-declared security_review: passed counts only when this resolves"
    }
  },
  "required": [
    "tool_id",
    "name",
    "type",
    "capabilities",
    "status",
    "approved_roles"
  ]
}
