{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/model-routing-overrides.schema.json",
  "title": "model-routing-overrides",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "tier": {
                  "type": "string",
                  "enum": [
                    "T0",
                    "T1",
                    "T2",
                    "T3"
                  ]
                },
                "max_reasoning": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "extra_high"
                  ]
                },
                "cost_per_1k_in": {
                  "type": "number"
                },
                "cost_per_1k_out": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "tier"
              ]
            }
          }
        },
        "required": [
          "name",
          "models"
        ]
      }
    },
    "role_overrides": {
      "type": "object",
      "description": "role -> {minimum_tier, default_reasoning}: may raise the kernel role defaults, never lower them (POLICY_PRECEDENCE)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "minimum_tier": {
            "type": "string",
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3"
            ]
          },
          "default_reasoning": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "extra_high"
            ]
          }
        }
      }
    },
    "task_class_overrides": {
      "type": "object",
      "description": "task class -> minimum tier: may raise MODEL_ROUTING_POLICY.task_class_minimum_tier, never lower it (POLICY_PRECEDENCE)",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "T0",
          "T1",
          "T2",
          "T3"
        ]
      }
    },
    "preferences": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "providers"
  ]
}
