{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/tool-permissions.schema.json",
  "title": "tool-permissions",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "READ_REPO",
            "WRITE_REPO_SCOPED",
            "RUN_TESTS",
            "NETWORK_READ",
            "NETWORK_WRITE",
            "PACKAGE_INSTALL",
            "SYSTEM_INSTALL",
            "DB_READ",
            "DB_WRITE",
            "CLOUD_READ",
            "CLOUD_WRITE",
            "CI_TRIGGER",
            "SECRET_READ",
            "DEPLOY_STAGING",
            "DEPLOY_PRODUCTION"
          ]
        }
      }
    },
    "install_authority_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_allowlist": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "mcp_servers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "roles"
  ]
}
