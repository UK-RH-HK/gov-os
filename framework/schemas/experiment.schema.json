{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/experiment.schema.json",
  "title": "experiment",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "experiment"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string",
      "description": "J2 hypothesis"
    },
    "method": {
      "type": "string",
      "description": "J2 method"
    },
    "data_provenance": {
      "type": "string",
      "description": "J2 data provenance (free text) when the data is not a governed record"
    },
    "measurements": {
      "type": [
        "object",
        "array"
      ]
    },
    "result": {
      "type": "string",
      "description": "legacy free-text result"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "production_merge_allowed": {
      "const": false
    },
    "experiment_state": {
      "enum": [
        "DESIGNED",
        "RUNNING",
        "CONCLUDED",
        "PROMOTED",
        "ABANDONED"
      ],
      "description": "lifecycle state (OS-written)"
    },
    "question": {
      "type": "string",
      "description": "J2 question (an alternative to a hypothesis)"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "J2 data: governed data/research/experiment record ids the experiment runs on (record ids; an id that names no governed record is reported by the lifecycle checks)"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "description": "repository files/directories or record ids the runs read; the OS binds each by SHA-256 at every run"
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "procedure": {
          "type": [
            "string",
            "array"
          ],
          "description": "how to re-run the experiment"
        },
        "environment": {
          "type": [
            "string",
            "object"
          ],
          "description": "toolchain/platform the results depend on"
        },
        "acceptance": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "exact",
                "tolerance"
              ]
            },
            "relative": {
              "type": "number",
              "minimum": 0
            },
            "absolute": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "how a reproduction is judged to agree (default exact)"
        },
        "status": {
          "enum": [
            "UNVERIFIED",
            "REPRODUCED",
            "NOT_REPRODUCED"
          ],
          "description": "OS-computed from the recorded runs"
        }
      },
      "description": "J2 reproducibility"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "OS-recorded runs: the primary run and every reproduction, with results digest, input hashes, session and role"
    },
    "results": {
      "description": "J2 results (the primary run's results, copied by the OS at conclusion)"
    },
    "interpretation": {
      "type": "string",
      "description": "J2 interpretation"
    },
    "decision_influence": {
      "type": [
        "string",
        "object"
      ],
      "description": "J2 decision influence: what the result means for which decisions"
    },
    "influences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "decisions/tasks that derive from this experiment (OS-maintained backlinks) (record ids; an id that names no governed record is reported by the lifecycle checks)"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "where experimental output lives (repository paths/globs); outside the production tree until promoted"
    },
    "promotion": {
      "type": "object",
      "description": "the governed promotion: gate, decision, subject digest, approved paths"
    },
    "abandon_reason": {
      "type": "string"
    },
    "recorded_by": {
      "type": "object"
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "os_binding": {
      "type": "object",
      "description": "T2 seal (runtime/src/t2.rs)"
    }
  },
  "required": [
    "id",
    "type",
    "status"
  ],
  "description": "A governed experiment (Contract v3 Gate J2, lines 607-614; framework §45-46). Lifecycle (`experiment_state`, OS-written through `gov experiment ...`, T2-sealed): DESIGNED (hypothesis/question, method, data) -> RUNNING (a primary run recorded with its inputs bound by hash) -> CONCLUDED (results, reproducibility, interpretation, decision influence, confidence) -> PROMOTED (a governed promotion: an owner-signed human answer approving the exact output paths). Any non-final state -> ABANDONED. An experiment in DESIGNED/RUNNING is held reference-only (state_class NARRATIVE). Experimental output never enters the production tree without a promotion (production_merge_allowed is always false).",
  "$defs": {
    "design": {
      "$comment": "Contract v3 J2 lines 608-609: hypothesis/question, method/data",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "\\S"
        },
        "hypothesis": {
          "type": "string",
          "pattern": "\\S"
        },
        "question": {
          "type": "string",
          "pattern": "\\S"
        },
        "data_provenance": {
          "type": "string",
          "pattern": "\\S"
        },
        "data": {
          "minItems": 1
        },
        "inputs": {
          "minItems": 1
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "hypothesis"
              ]
            },
            {
              "required": [
                "question"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "data"
              ]
            },
            {
              "required": [
                "data_provenance"
              ]
            },
            {
              "required": [
                "inputs"
              ]
            }
          ]
        }
      ]
    },
    "conclusion": {
      "$comment": "Contract v3 J2 lines 610-613: reproducibility, results, interpretation, decision influence (+ confidence)",
      "required": [
        "reproducibility",
        "interpretation",
        "decision_influence",
        "confidence"
      ],
      "properties": {
        "reproducibility": {
          "required": [
            "procedure",
            "environment"
          ],
          "properties": {
            "procedure": {
              "minLength": 1,
              "minItems": 1
            },
            "environment": {
              "minLength": 1,
              "minProperties": 1
            }
          }
        },
        "interpretation": {
          "type": "string",
          "pattern": "\\S"
        },
        "decision_influence": {
          "pattern": "\\S",
          "minProperties": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "results"
          ]
        },
        {
          "required": [
            "result"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "$comment": "J2: a current experiment that claims evidence (state_class absent = policy default EVIDENCE) is governed through the lifecycle and records its design",
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ACTIVE",
              "PROVISIONAL"
            ]
          },
          "state_class": {
            "enum": [
              "EVIDENCE",
              "AUTHORITATIVE",
              "DERIVED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "experiment_state"
        ],
        "allOf": [
          {
            "$ref": "#/$defs/design"
          }
        ]
      }
    },
    {
      "$comment": "every lifecycle state after design records hypothesis/question, method and data",
      "if": {
        "required": [
          "experiment_state"
        ],
        "properties": {
          "experiment_state": {
            "enum": [
              "DESIGNED",
              "RUNNING",
              "CONCLUDED",
              "PROMOTED"
            ]
          }
        }
      },
      "then": {
        "$ref": "#/$defs/design"
      }
    },
    {
      "$comment": "J2: a concluded experiment records results, reproducibility, interpretation, decision influence and confidence",
      "if": {
        "required": [
          "experiment_state"
        ],
        "properties": {
          "experiment_state": {
            "enum": [
              "CONCLUDED",
              "PROMOTED"
            ]
          }
        }
      },
      "then": {
        "$ref": "#/$defs/conclusion"
      }
    },
    {
      "$comment": "J2: a promotion is governed (gate, subject digest, approved paths)",
      "if": {
        "required": [
          "experiment_state"
        ],
        "properties": {
          "experiment_state": {
            "const": "PROMOTED"
          }
        }
      },
      "then": {
        "required": [
          "promotion"
        ],
        "properties": {
          "promotion": {
            "required": [
              "gate",
              "paths",
              "subject_sha256"
            ]
          }
        }
      }
    },
    {
      "$comment": "an experiment in progress is not evidence yet",
      "if": {
        "required": [
          "experiment_state"
        ],
        "properties": {
          "experiment_state": {
            "enum": [
              "DESIGNED",
              "RUNNING"
            ]
          }
        }
      },
      "then": {
        "required": [
          "state_class"
        ],
        "properties": {
          "state_class": {
            "enum": [
              "NARRATIVE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "experiment_state"
        ],
        "properties": {
          "experiment_state": {
            "const": "ABANDONED"
          }
        }
      },
      "then": {
        "required": [
          "abandon_reason"
        ]
      }
    }
  ]
}
