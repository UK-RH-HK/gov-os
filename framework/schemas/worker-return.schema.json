{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/worker-return.schema.json",
  "title": "worker-return",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "task": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "work_completed": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "object"
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_action": {
      "type": "string"
    },
    "context_packet_hash": {
      "type": "string"
    },
    "inputs_consumed": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+(@.+)?$"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "content_hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        ]
      }
    },
    "outputs_produced": {
      "type": "array"
    },
    "requirements_implemented": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios_implemented": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features_implemented": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_applicable_with_reason"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "test",
          "result"
        ]
      }
    },
    "deviations": {
      "type": "array"
    }
  },
  "required": [
    "task",
    "status",
    "work_completed",
    "files_changed",
    "evidence",
    "tests",
    "discoveries",
    "risks",
    "lessons",
    "proposed_decisions",
    "unresolved",
    "recommended_next_action"
  ],
  "description": "The worker's structured return. It is the consumption receipt (Contract v3 W5; one contract with the task-close report through the lossless mapping context::receipt::report_from_worker_return, `status` -> `outcome`). The receipt fields below are required when the return closes a task: `gov task close` validates them against the task's manifest and the packet it names (RECEIPT_INVALID otherwise); the packet's `receipt_contract` states exactly what the return must contain."
}
