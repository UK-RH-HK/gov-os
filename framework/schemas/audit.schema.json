{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/audit.schema.json",
  "title": "audit",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "audit"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "description": "governance-suite (health-system output, excluded from the currency key), product-tests (per-family product-test evidence, excluded from the key), or any other audit scope (an input)"
    },
    "auditor_role": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "families": {
      "type": "object",
      "description": "governance-suite: family -> {ok, findings, detail, status, cached_from}; product-tests: family -> {status, exit, command, cwd, covers, key, source, attributed, duration_ms}"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "family": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "accepted_exception": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "message"
        ]
      }
    },
    "verdict": {
      "type": "string"
    },
    "inputs_hash": {
      "type": "string",
      "description": "suite currency key: digest over every evidence input class (Contract v3:97-109); a green record is current only while it equals the key of the current inputs"
    },
    "result_hash": {
      "type": "string"
    },
    "green": {
      "type": "boolean"
    },
    "inputs": {
      "type": "object",
      "description": "per input class digest (class id -> sha256) from which inputs_hash was computed; staleness names the classes that changed",
      "additionalProperties": {
        "type": "string"
      }
    },
    "suite_verdict": {
      "type": "string",
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "UNHEALTHY",
        "INCOMPLETE"
      ]
    },
    "complete": {
      "type": "boolean",
      "description": "every suite family has a result valid for inputs_hash (executed in this run or reused from the cache under an identical key)"
    },
    "reproducible": {
      "type": "boolean"
    },
    "tier": {
      "type": "string",
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6"
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "health_result": {
      "type": "string",
      "description": "id of the scheduler's ledger result (.governance-runtime/health/results/<id>.json)"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "executed",
              "reused",
              "not-evaluated"
            ]
          },
          "key": {
            "type": "string"
          },
          "cached_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "threads": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isolation": {
            "type": "string"
          },
          "reproducible": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "enforcement": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    },
    "run_summary": {
      "type": "object"
    },
    "parallelism": {
      "type": "object"
    },
    "cache_mode": {
      "type": "string",
      "enum": [
        "use",
        "refresh",
        "off"
      ]
    },
    "runtime": {
      "type": "object",
      "description": "runtime implementation identity: crate versions and the SHA-256 of the executing binary",
      "properties": {
        "binary_sha256": {
          "type": "string"
        },
        "cli_version": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        }
      }
    },
    "machine_trust": {
      "type": "object"
    },
    "repository": {
      "type": "object",
      "description": "repository state: commit, dirty files, content key"
    },
    "actor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      }
    },
    "run_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "deep": {
      "type": "boolean"
    },
    "failed_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "type",
    "status"
  ]
}
