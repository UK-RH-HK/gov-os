{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/scenario.schema.json",
  "title": "scenario",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "scenario"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "feature": {
      "type": "string",
      "description": "the feature this scenario realises"
    },
    "actor": {
      "type": "string"
    },
    "given": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "then": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "H4 DATA: ids of the `data` records (data_kind requirement) this scenario needs"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "H4 SUCCESS criteria (measurable)"
    },
    "failure_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "H4 FAILURE criteria (measurable)"
    },
    "data_requirements_not_applicable": {
      "type": "string",
      "description": "why this scenario needs no data (an explicit, reasoned N/A; a silent N/A is a gap)"
    }
  },
  "required": [
    "id",
    "type",
    "status"
  ],
  "description": "A scenario (Contract v3 Gate H4, lines 524-527; framework §39). The chain FEATURE -> SCENARIOS -> DATA -> TEST DATA -> SUCCESS/FAILURE -> INDEPENDENT TESTS is carried by these fields: `feature` (or the feature's `scenarios`), `data_requirements` (ids of `data` records of data_kind requirement; or `data_requirements_not_applicable` with the reason - a silent N/A is a gap), `success_criteria`, `failure_criteria`; test datasets name the requirements they realise (`implements`), carry `provenance` and OS-recorded authorship (`gov data register`); test obligations name the scenario (`scenario`) and the test data they use (`test_data`). Missing links are reported by `gov scenario check` / `gov scenario trace` (runtime/src/lifecycle/scenario.rs)."
}
