{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.4/policy-BUDGET_POLICY.schema.json",
  "title": "policy-BUDGET_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "BUDGET_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "governed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object"
    },
    "on_threshold_exceeded": {
      "type": "string"
    }
  },
  "required": [
    "policy",
    "version",
    "defaults"
  ]
}
