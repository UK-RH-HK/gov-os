{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/record.schema.json",
  "title": "record",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "description": "Declared producer/provenance (who or what produced the record, from what). Version-control provenance (introducing and last-changing commit) is derived by `gov artefact show`."
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Expected downstream consumers: each id yields the canonical edge '<id> CONSUMES <this record>'."
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Producers of this record: each id yields the canonical edge '<id> PRODUCES <this record>'."
    },
    "influences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Decisions/tasks this output influences: each id yields '<this record> AFFECTS <id>'."
    }
  },
  "required": [
    "id",
    "type",
    "status"
  ],
  "$defs": {
    "relation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DEPENDS_ON",
            "BLOCKS",
            "IMPLEMENTS",
            "REALISES",
            "GOVERNED_BY",
            "CONSTRAINS",
            "DERIVED_FROM",
            "SUPERSEDES",
            "VALIDATED_BY",
            "TESTS",
            "USES",
            "PRODUCES",
            "CONSUMES",
            "AFFECTS",
            "GENERATED_FROM",
            "CALLS",
            "IMPORTS",
            "OWNS",
            "FAILED_BECAUSE",
            "LEARNED_FROM"
          ]
        },
        "target": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "release"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "description": "A release of the governed product (Contract v3 W8:1147 '... -> evidence -> release'; stored under spec/releases/REL-*). `derived_from` names the work it ships (tasks, close reports) and `validated_by` the evidence that validated it (audits, test evidence); both are relation fields, so the release is reachable in forward lineage and in reverse impact. Not a Governance OS kernel release.",
        "required": [
          "version",
          "derived_from",
          "validated_by"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "validated_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  ]
}
