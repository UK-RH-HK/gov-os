{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/policy-TOOL_POLICY.schema.json",
  "title": "policy-TOOL_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "TOOL_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "permission_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_install_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_licences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "health_check_required": {
      "type": "boolean"
    },
    "mcp": {
      "type": "object"
    }
  },
  "required": [
    "policy",
    "version",
    "permission_classes",
    "auto_install_conditions"
  ]
}
