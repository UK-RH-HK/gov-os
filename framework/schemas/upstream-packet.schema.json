{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/upstream-packet.schema.json",
  "title": "upstream-packet",
  "x-schema-version": "1.2.0",
  "type": "object",
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "scope": {
      "const": "FRAMEWORK"
    },
    "category": {
      "type": "string"
    },
    "problem_statement": {
      "type": "string"
    },
    "generic_failure_mode": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "suggested_framework_change": {
      "type": "string"
    },
    "source_project_alias": {
      "type": "string"
    },
    "local_reference": {
      "type": "string"
    },
    "sensitive_content_removed": {
      "const": true
    },
    "raw_product_code_included": {
      "const": false
    },
    "raw_customer_data_included": {
      "const": false
    },
    "raw_spec_included": {
      "const": false
    },
    "synthetic_fixture": {
      "type": [
        "object",
        "null"
      ]
    },
    "metrics": {
      "type": [
        "object",
        "null"
      ]
    },
    "payload_hash": {
      "type": "string"
    },
    "prepared_at": {
      "type": "string"
    },
    "framework_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "approval": {
      "type": "object",
      "description": "approval of this exact packet. At prepare: the export gate raised for it (gate, subject_sha256). At submit (upstream::resolve_export_approval): with LEARNING_POLICY.upstream.approval=human, the owner-signed human answer authorising the packet's export gate (trigger upstream_export), whose subject binds packet id, lesson and payload hash (channel human-gate, authenticated true); --approved-by is only recorded as approved_by_claim. With approval=policy no human approval is asserted (channel policy, human_approval false).",
      "properties": {
        "required": {
          "type": "string",
          "enum": [
            "human",
            "policy"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "who approved as the verified human answer records it (answered_by of the owner-signed document); null unless a human approval was verified"
        },
        "approved_by_claim": {
          "type": [
            "string",
            "null"
          ],
          "description": "the caller's --approved-by string: a request, recorded and ignored (D-0007 rule 2)"
        },
        "channel": {
          "type": "string",
          "enum": [
            "human-gate",
            "policy"
          ]
        },
        "authenticated": {
          "type": "boolean"
        },
        "human_approval": {
          "type": "boolean"
        },
        "gate": {
          "type": [
            "string",
            "null"
          ],
          "description": "the export-approval Human Decision Gate"
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "option": {
          "type": "string"
        },
        "subject_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": "object",
          "description": "upstream::export_subject: kind upstream-export, id (packet id), lesson_id, payload_hash, sha256"
        },
        "human_evidence": {
          "type": [
            "object",
            "null"
          ],
          "description": "signing key ids, anchor and envelope digest of the owner-signed answer"
        },
        "approved_at": {
          "type": "string"
        },
        "binds": {
          "type": "object",
          "properties": {
            "packet_id": {
              "type": "string"
            },
            "lesson_id": {
              "type": "string"
            },
            "payload_hash": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            }
          }
        }
      }
    },
    "scans": {
      "type": "object",
      "description": "export-gate scans; `content` holds the content controls (reproduced repository lines, index data, opaque blobs)",
      "properties": {
        "content": {
          "type": "object"
        }
      }
    }
  },
  "required": [
    "packet_id",
    "lesson_id",
    "scope",
    "category",
    "problem_statement",
    "generic_failure_mode",
    "impact",
    "evidence_strength",
    "suggested_framework_change",
    "source_project_alias",
    "sensitive_content_removed",
    "raw_product_code_included",
    "raw_customer_data_included",
    "raw_spec_included"
  ]
}
