{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/cit.schema.json",
  "title": "cit",
  "x-schema-version": "1.2.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "cit"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "cit_status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "SIMULATED",
        "APPROVED",
        "REJECTED",
        "EXECUTING",
        "COMMITTED",
        "ROLLED_BACK",
        "BLOCKED"
      ]
    },
    "proposal": {
      "type": "string"
    },
    "proposed_by": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mutation_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "set_status",
              "set_field",
              "write_file",
              "move_file",
              "delete_file",
              "append_record",
              "mark_stale",
              "set_lock_field",
              "regenerate_views",
              "register_plugin"
            ]
          },
          "target": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "value": {},
          "content": {
            "type": "string"
          },
          "record": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          },
          "plugin_id": {
            "type": "string",
            "description": "`register_plugin`: the plugin a registration transaction registers"
          },
          "descriptor": {
            "type": "object",
            "description": "`register_plugin`: the OS-normalised descriptor the registration writes (part of the content the approval binds)"
          },
          "subject_sha256": {
            "type": "string",
            "description": "`register_plugin`: the registration subject; CIT-E writes only when the plugin's bytes still give exactly this subject and its execution approval (a gate raised for exactly this subject) is honoured"
          },
          "registry": {
            "type": "string"
          },
          "implementation_sha256": {
            "type": "string"
          },
          "execution_class": {
            "type": "string"
          }
        },
        "required": [
          "op"
        ]
      }
    },
    "impact": {
      "type": "object"
    },
    "approval": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "decision": {
      "type": "string"
    },
    "human_gate": {
      "type": "string"
    },
    "journal": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "proposer",
        "system"
      ],
      "description": "`system`: a transaction the OS itself recorded or proposed — the propagation of an upstream change detected outside change control (`system.kind: direct-change propagation`, `trigger: propagation`, no mutation manifest, bookkeeping writes only), whose touched list and sealed per-path writes cover what it marked; or a plugin registration requested with `gov plugins register` (`system.kind: plugin-registration`, one `register_plugin` operation, simulated, gated and executed like any transaction). Absent: proposed through `gov cit propose` (which strips this field from proposer input)."
    },
    "system": {
      "type": "object",
      "description": "For `origin: system`: what the OS recorded and why (kind, the operation that detected the change, the inputs that changed)."
    },
    "os_state": {
      "type": "object",
      "description": "OS-owned: the sealed CIT state (cit::binding). Stripped from proposer input."
    },
    "os_binding": {
      "type": "object",
      "description": "OS-owned: the T2 seal of the whole record (t2::seal_record), renewed by every CIT operation; a hand edit breaks it. Stripped from proposer input."
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "cit_status",
    "proposal",
    "mutation_manifest"
  ]
}
