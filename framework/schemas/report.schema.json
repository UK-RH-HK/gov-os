{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/report.schema.json",
  "title": "report",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "report"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "object"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "work_completed": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_action": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "skills_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "tools_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "object"
    },
    "cost": {
      "type": "object"
    },
    "repair_count": {
      "type": "integer"
    },
    "context_packet_hash": {
      "type": "string"
    },
    "inputs_consumed": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+(@.+)?$"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "content_hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        ]
      }
    },
    "outputs_produced": {
      "type": "array"
    },
    "requirements_implemented": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios_implemented": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features_implemented": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_applicable_with_reason"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "test",
          "result"
        ]
      }
    },
    "deviations": {
      "type": "array"
    },
    "receipt_validation": {
      "type": "object",
      "description": "the receipt verdict recorded at close (context::receipt::ReceiptCheck::summary)"
    },
    "observed_files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "mutations observed since the claim baseline, independently of the report"
    },
    "mutation_evidence": {
      "type": "object",
      "description": "what the close accepted: the claim and its sealed baseline, observed content hashes (recorded authorship), CIT-covered and attributed paths, the OS-managed paths accepted as the OS's own writes, overrides"
    },
    "close_gate": {
      "type": "object",
      "description": "the health close gate's result (verification::close_gate: G2 health result, governance-affecting reasons) and the governing Human Decision Gates' authorisation"
    },
    "degraded": {
      "type": "array",
      "description": "degradations a forced or policy-permitted close recorded"
    },
    "os_binding": {
      "type": "object",
      "description": "T2 seal (t2::SEAL_FIELD) written by the close"
    }
  },
  "required": [
    "id",
    "type",
    "status"
  ],
  "description": "A task-close report. The worker's structured return is the consumption receipt (Contract v3 W5): context::receipt::report_from_worker_return maps it losslessly (worker `status` -> `outcome`), and the receipt fields are validated at close against the task's manifest and the packet it names (context::receipt::require_valid). The OS adds the close fields and seals the record (T2): a report no close wrote is never honoured."
}
