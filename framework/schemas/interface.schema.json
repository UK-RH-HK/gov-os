{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/interface.schema.json",
  "title": "interface",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "interface"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "api",
        "event",
        "cli",
        "schema",
        "protocol"
      ]
    },
    "contract": {
      "type": "object"
    },
    "version": {
      "type": "string"
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Records that consume this interface. Each id yields the canonical edge '<id> CONSUMES <this interface>' (stored as CONSUMED_BY and read back canonically by the graph): a change to the interface reaches its consumers."
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Records that produce/implement this interface. Each id yields the canonical edge '<id> PRODUCES <this interface>'."
    }
  },
  "required": [
    "id",
    "type",
    "status"
  ]
}
