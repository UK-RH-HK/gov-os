{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/plugin-registry.schema.json",
  "title": "plugin-registry",
  "x-schema-version": "1.1.0",
  "type": "object",
  "description": "Authoritative record of capability-plugin registrations at governance/registry/plugin-registry.json (tracked OS-written T2 state, never a regenerable view: BC-P2-31; a registry still at the legacy location governance/generated/plugin-registry.json is read until the next registry write moves it), written only by `gov plugins register` / `gov plugins unregister`. Binds plugin identity, version, descriptor bytes, the implementation the OS derived (every bound file) and the registration subject its approving gate answered, and carries the T2 seal (os_binding) of the registering operation; an entry whose seal does not verify on this machine is never honoured.",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "plugins": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "plugin_id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "number"
            ]
          },
          "descriptor_path": {
            "type": "string"
          },
          "descriptor_sha256": {
            "type": "string"
          },
          "implementation_sha256": {
            "type": "string",
            "description": "sha256 over every bound file (path, sha256); never null"
          },
          "implementation_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_permission_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "object"
          },
          "registration_gate": {
            "type": [
              "string",
              "null"
            ]
          },
          "registered_by_session": {
            "type": "string"
          },
          "registered_by_role": {
            "type": "string"
          },
          "registered_at": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "execution_class": {
            "type": "string",
            "enum": [
              "EXECUTABLE",
              "OS_PROVIDED"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "program": {
            "type": "string",
            "description": "the resolved program (absolute, symlinks followed)"
          },
          "implementation": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          "registration_subject_sha256": {
            "type": "string",
            "description": "the subject the approving gate's answer is bound to (identity, version, normalized descriptor, implementation)"
          },
          "os_binding": {
            "type": "object",
            "description": "T2 seal of the `plugins register` operation (runtime/src/t2.rs)",
            "properties": {
              "alg": {
                "type": "string"
              },
              "key_id": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "mac": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "plugin_id",
          "capability",
          "version",
          "descriptor_sha256",
          "implementation_sha256",
          "registration_subject_sha256",
          "registered_at",
          "registered_by_role",
          "os_binding"
        ]
      }
    },
    "os_binding": {
      "type": "object",
      "description": "T2 seal of the last registry-writing operation over the whole document (task-close mutation scope), present only when every entry is one a gov operation on this machine wrote; each entry carries its own seal as well"
    }
  },
  "required": [
    "schema_version",
    "plugins"
  ]
}
