{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/task.schema.json",
  "title": "task",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "task"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "the reason for the dependency, when the relation declares an input (Contract v3 W3)"
          },
          "required": {
            "type": "boolean",
            "description": "an input relation is required unless this is false"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "description": "OS-recorded producer of the record (W1): written by the operation that created it (`gov task create`, `gov readiness plan`); a caller-supplied value is kept as `provenance_requested` and proves nothing (D-0007 rule 2).",
      "properties": {
        "producer": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "class": {
      "type": "string",
      "enum": [
        "discovery",
        "research",
        "experiment",
        "specification",
        "decision-preparation",
        "data",
        "architecture",
        "implementation",
        "integration",
        "test-design",
        "test-execution",
        "security",
        "devops",
        "performance",
        "validation",
        "refactor",
        "repair",
        "documentation",
        "release",
        "tooling",
        "memory",
        "governance",
        "migration"
      ]
    },
    "task_status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "BLOCKED",
        "CLAIMED",
        "IN_PROGRESS",
        "REVIEW",
        "DONE",
        "CANCELLED",
        "WAITING_HUMAN"
      ]
    },
    "feature": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "READ_REPO",
          "WRITE_REPO_SCOPED",
          "RUN_TESTS",
          "NETWORK_READ",
          "NETWORK_WRITE",
          "PACKAGE_INSTALL",
          "SYSTEM_INSTALL",
          "DB_READ",
          "DB_WRITE",
          "CLOUD_READ",
          "CLOUD_WRITE",
          "CI_TRIGGER",
          "SECRET_READ",
          "DEPLOY_STAGING",
          "DEPLOY_PRODUCTION"
        ]
      }
    },
    "minimum_model_tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "minimum_reasoning": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "extra_high"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production_merge_allowed": {
      "type": "boolean"
    },
    "human_gate": {
      "type": "string"
    },
    "readiness_cell": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "retest_required": {
      "type": "boolean"
    },
    "claim": {
      "type": "object"
    },
    "closed_by_report": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "The designated role: it binds who may claim and close the task (ROLE_NOT_DESIGNATED); independence of tests and test data from it is established from recorded authorship (BC-P2-34)."
    },
    "estimate": {
      "type": "string"
    },
    "required_inputs": {
      "type": "array",
      "description": "Mandatory upstream inputs with their constraints and reasons (Contract v3 W3). A task whose required input is absent, superseded, conflicting, not current or constraint-violating is not runnable (orchestration::dag::evaluate).",
      "items": {
        "type": "object",
        "description": "An entry of the explicit task-input manifest (Contract v3 W3; context-packet.schema.json $defs/task_input_declaration): the input id, whether it is required, the authority/lifecycle state and version/hash constraints it must meet, and the reason for the dependency.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "slot name, list-field name or record type the input must satisfy"
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "required_status": {
            "type": [
              "string",
              "array"
            ]
          },
          "required_state_class": {
            "type": [
              "string",
              "array"
            ]
          },
          "version": {
            "type": "string",
            "description": "exact version, '*', or comparators: =X >=X >X <=X <X ^X ~X"
          },
          "content_hash": {
            "type": "string",
            "description": "SHA-256 of the record bytes (or a prefix of at least 12 hex characters)"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "optional_inputs": {
      "type": "array",
      "description": "Optional upstream inputs (same entry shape; `required: false`).",
      "items": {
        "type": "object",
        "description": "An entry of the explicit task-input manifest (Contract v3 W3; context-packet.schema.json $defs/task_input_declaration): the input id, whether it is required, the authority/lifecycle state and version/hash constraints it must meet, and the reason for the dependency.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "slot name, list-field name or record type the input must satisfy"
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "required_status": {
            "type": [
              "string",
              "array"
            ]
          },
          "required_state_class": {
            "type": [
              "string",
              "array"
            ]
          },
          "version": {
            "type": "string",
            "description": "exact version, '*', or comparators: =X >=X >X <=X <X ^X ~X"
          },
          "content_hash": {
            "type": "string",
            "description": "SHA-256 of the record bytes (or a prefix of at least 12 hex characters)"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "supplementary_context": {
      "type": "array",
      "description": "Supplementary context declared separately from the mandatory inputs (Contract v3 W3); delivered in the supplementary block, never as authority.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        ]
      }
    },
    "architecture": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Architecture records this task must conform to (mandatory inputs)."
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_requested": {
      "type": "object",
      "description": "a provenance value the caller supplied at create (a request, recorded and ignored)"
    },
    "status_source": {
      "type": "object",
      "description": "The operation that last set task_status. A BLOCKED/WAITING_HUMAN set by `gov task status` is an explicit hold the DAG keeps until an explicit READY; every other source is derived and recomputed from the DAG.",
      "properties": {
        "operation": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "type": "string"
        }
      }
    },
    "status_note": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    },
    "outputs_produced": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the task produced, as observed at its close (the task -> output lineage edges, Contract v3 W5/W8)."
    },
    "retest_reason": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "class",
    "task_status",
    "objective"
  ]
}
