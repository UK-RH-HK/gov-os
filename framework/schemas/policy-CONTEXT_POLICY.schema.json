{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.4/policy-CONTEXT_POLICY.schema.json",
  "title": "policy-CONTEXT_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "CONTEXT_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "packet_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deterministic_authority_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieved_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_packet_chars": {
      "type": "integer"
    },
    "max_retrieved_slices": {
      "type": "integer"
    },
    "fresh_agent_read_budget_files": {
      "type": "integer"
    },
    "reproducibility": {
      "type": "string"
    }
  },
  "required": [
    "policy",
    "version",
    "max_packet_chars",
    "max_retrieved_slices"
  ]
}
