{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/framework-lock.schema.json",
  "title": "framework-lock",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "framework": {
      "const": "agentic-engineering-os"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "release_commit": {
      "type": "string",
      "description": "commit of the installed framework release (release manifest / embedded payload / framework checkout), never the consumer repository's HEAD"
    },
    "release_hash": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "logical, machine-independent source label (release:<fw>@<v> | embedded:<fw>@<v> | source:<fw>@<v>)",
      "pattern": "^(release|embedded|source):"
    },
    "installed_at": {
      "type": "string"
    },
    "kernel_manifest_hash": {
      "type": "string"
    },
    "cli_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "schema_versions": {
      "type": "object"
    },
    "lock_schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "installed_at_commit": {
      "type": "string",
      "description": "consumer repository HEAD when the kernel was installed or updated"
    }
  },
  "required": [
    "framework",
    "version",
    "release_hash",
    "source",
    "kernel_manifest_hash"
  ]
}
