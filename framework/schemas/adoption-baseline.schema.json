{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/adoption-baseline.schema.json",
  "title": "adoption-baseline",
  "x-schema-version": "1.2.0",
  "type": "object",
  "properties": {
    "adoption_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "dirty_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "untracked_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_tests": {
      "type": "object"
    },
    "interrupted_work": {
      "type": "object"
    },
    "stage_status": {
      "type": "object"
    },
    "verdicts": {
      "type": "object",
      "description": "independent verdicts A5/A7/A10/A11",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "role_source": {
            "type": "string"
          },
          "session_source": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "independence": {
            "type": "object",
            "description": "designated role, the builders it was judged against, established"
          },
          "catalogue_sha256": {
            "type": "string",
            "description": "planner::catalogue_digest of the catalogue judged"
          },
          "plan_sha256": {
            "type": "string"
          },
          "tests_sha256": {
            "type": "string"
          },
          "reviewer_tests": {
            "type": "array",
            "description": "A5: ids of the tests the reviewer authored"
          },
          "reviewer_tests_count": {
            "type": "integer"
          },
          "approval_bound": {
            "type": "boolean",
            "description": "A7: the verified tree, tests and plan are the ones A5 approved"
          },
          "verifier_queries": {
            "type": "array",
            "description": "A10: ids of the held-out queries the memory verifier authored"
          },
          "audit": {
            "type": "string",
            "description": "A11: the G5 governance-suite audit record"
          },
          "tier": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "description": "A11: why the verdict is not ADOPTED_HEALTHY (failed criteria, adoption findings, audit and doctor verdicts)"
          },
          "reason": {
            "description": "A11: the installation posture when it is the only reason (doctor D032: release authenticity not established on this machine), else null"
          }
        }
      }
    },
    "planner_session": {
      "type": "string",
      "description": "session that ran A0 (Role A)"
    },
    "executor_session": {
      "type": "string",
      "description": "session of the latest A6 invocation (Role C)"
    },
    "memory_builder_session": {
      "type": "string",
      "description": "session of the latest A9 invocation (Role E)"
    },
    "stage_times": {
      "type": "object"
    },
    "authors": {
      "type": "array",
      "description": "authorship log: every stage records its declared role and declared session; an independent stage (A5, A7, A10, A11) is refused when its session or role authored a planner/executor/memory-builder stage, and a session keeps one role for the whole adoption",
      "items": {
        "type": "object",
        "required": [
          "group",
          "role",
          "session",
          "stages"
        ],
        "properties": {
          "group": {
            "type": "string",
            "enum": [
              "planner",
              "executor",
              "memory_builder",
              "independent"
            ]
          },
          "role": {
            "type": "string",
            "description": "the declared acting role (adapter-declared, OWNER-DECISION-P2-0001)"
          },
          "role_source": {
            "type": "string"
          },
          "session": {
            "type": "string",
            "description": "the declared session"
          },
          "session_source": {
            "type": "string",
            "enum": [
              "installed",
              "flag",
              "stage-flag",
              "environment"
            ]
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_at": {
            "type": "string"
          },
          "last_at": {
            "type": "string"
          }
        }
      }
    },
    "test_design": {
      "type": "object",
      "description": "A5 scaffold record: identities of every planner-scaffolded test (never counted as reviewer-authored)",
      "properties": {
        "scaffold_identities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scaffold_sha256": {
          "type": "string"
        },
        "scaffold_tests": {
          "type": "integer"
        },
        "by": {
          "type": "object"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "migration_execution": {
      "type": "object",
      "description": "A6: the approved digests the executed batches were checked against"
    },
    "memory_build": {
      "type": "object",
      "description": "A9: the builder's held-out set (identities; regression evidence only)",
      "properties": {
        "heldout_file": {
          "type": "string"
        },
        "builder_query_identities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated": {
          "type": "integer"
        },
        "manifest_hash": {
          "type": "string"
        }
      }
    },
    "final_verdict": {
      "type": "string"
    },
    "os_binding": {
      "type": "object",
      "description": "T2 seal (runtime t2::SEAL_FIELD)"
    }
  },
  "required": [
    "adoption_id",
    "started_at",
    "stage_status"
  ],
  "description": "The adoption record (spec/audits/GOVERNANCE-ADOPTION/00-BASELINE.yaml). OS-written T2 state: sealed (os_binding) by every adoption stage that writes it and honoured only when the seal verifies. It carries the stage order, the authorship log and every independent verdict with what it was bound to (BC-P2-34)."
}
