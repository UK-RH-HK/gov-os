    "evidence_owner": {
      "description": "Governed (BC-P2-02, frozen AC-10): one evidence owner. `id` is `<kind>:<reference>`; `gov contract verify` resolves it against the product (scheduler catalogue and tiers, G0 command classification, the test harnesses' module trees, independent held-out suites, the frozen gate contract). `class` is a Contract v3:83-91 evidence class the kind produces; `tiers` (check, doctor, g0) equal what the product declares; `record` (human-gate, release) is the record type the command writes; `tests` (heldout) name `<binary>::<fn>` tests of the suite; `exercises` states what the owner exercises.",
      "type": "object",
      "required": [
        "id",
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(check|doctor|g0|test|human-gate|release|heldout|obligation):.+$"
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^G[0-6]$"
          }
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+::[A-Za-z0-9_]+$"
          }
        },
        "exercises": {
          "type": "string",
          "minLength": 1
        }
      }
    },
