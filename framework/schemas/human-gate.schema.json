{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/human-gate.schema.json",
  "title": "human-gate",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "human-gate"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PRESENTED",
        "ANSWERED",
        "EXPIRED",
        "WITHDRAWN"
      ]
    },
    "question": {
      "type": "string"
    },
    "why_now": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "authorises_blocked_work": {
            "type": "boolean",
            "description": "whether choosing this option authorises the work the gate blocks (default: only option A)"
          }
        }
      },
      "minItems": 1
    },
    "impact": {
      "type": "string"
    },
    "reversibility": {
      "type": "string"
    },
    "cost_rework": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "permitted_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presented_in_chat": {
      "type": "boolean"
    },
    "presented_at": {
      "type": "string"
    },
    "answer": {
      "type": "object"
    },
    "priority_score": {
      "type": "number"
    },
    "trigger": {
      "type": "string"
    },
    "cit": {
      "type": "string"
    },
    "gate_instance": {
      "type": "string",
      "description": "OS-issued nonce of this gate instance; an owner-signed answer binds it"
    },
    "impact_radius": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "reversible": {
      "type": "boolean"
    },
    "raised_by": {
      "type": "object",
      "description": "who raised the gate: kind agent|system, session, role"
    },
    "assessment": {
      "type": "object",
      "description": "the impact radius / reversibility / confidence assessment agent resolution is judged on, and its source (declared|os)"
    },
    "presentation": {
      "type": "object",
      "description": "the OS rendering of the package (rendered_at, rendered_by, package_sha256); not a human receipt"
    },
    "presented_by": {
      "type": "object"
    },
    "presentation_receipt": {
      "type": "object",
      "description": "owner-signed evidence that the package reached the human (a receipt or a signed answer)"
    },
    "revoked": {
      "type": "object"
    },
    "subject": {
      "type": "object",
      "description": "what the approval is bound to (kind, id, sha256)"
    },
    "decision_scope": {
      "type": "object",
      "description": "fields carried into the resulting decision (e.g. authorises_exceptions, permits_policy_keys)"
    },
    "os_binding": {
      "type": "object",
      "description": "T2 seal: the record was written by a gov operation (runtime t2)"
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "gate_status",
    "question"
  ]
}
