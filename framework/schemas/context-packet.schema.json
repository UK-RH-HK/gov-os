{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/context-packet.schema.json",
  "title": "context-packet",
  "x-schema-version": "1.1.0",
  "description": "A task context packet (framework §15; Contract v3 W4 lines 1106-1112, W10 lines 1162-1171). deterministic_authority carries the normative content of every mandatory input with its exact id, version and content hash; input_manifest records how the task's declared inputs resolved (delivery_state BLOCKED names every missing or violated input); retrieved_intelligence is supplementary only and is the only block a retrieval/index failure or token pressure may degrade. packet_hash covers the deterministic block, the manifest, the receipt contract and the supplementary block.",
  "type": "object",
  "properties": {
    "packet_id": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "delivery_state": {
      "enum": [
        "COMPLETE",
        "BLOCKED"
      ],
      "description": "COMPLETE when every required input of the task's manifest is satisfied; BLOCKED otherwise (Contract v3 W4 line 1112)."
    },
    "supplementary_state": {
      "enum": [
        "COMPLETE",
        "DEGRADED"
      ],
      "description": "DEGRADED when retrieval or the derived index failed; retrieved_intelligence.degraded names the reasons. Never affects delivery_state."
    },
    "deterministic_authority": {
      "type": "object",
      "properties": {
        "governing_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "active_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "conflicting_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "architecture": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "test_designs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "evidence_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        },
        "other_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivered_input"
          }
        }
      }
    },
    "deterministic_hash": {
      "type": "string"
    },
    "input_manifest": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "delivery_state": {
          "enum": [
            "COMPLETE",
            "BLOCKED"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manifest_entry"
          }
        },
        "missing_inputs": {
          "type": "array"
        },
        "input_violations": {
          "type": "array"
        },
        "advisories": {
          "type": "array"
        },
        "supplementary_context": {
          "type": "array"
        }
      },
      "required": [
        "task",
        "delivery_state",
        "inputs",
        "missing_inputs",
        "input_violations"
      ]
    },
    "manifest_hash": {
      "type": "string"
    },
    "input_hashes": {
      "type": "object",
      "description": "Every supplied input id -> SHA-256 of its record bytes: what the worker was supplied.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "receipt_contract": {
      "type": "object",
      "description": "What the worker's return (the consumption receipt, $defs/consumption_receipt) must contain for this task."
    },
    "retrieved_intelligence": {
      "type": "object"
    },
    "packet_hash": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "repo_commit": {
          "type": "string"
        },
        "inputs_uncommitted": {
          "type": [
            "array",
            "null"
          ]
        },
        "compiler": {
          "type": "object"
        },
        "index_available": {
          "type": "boolean"
        }
      }
    },
    "compiled_at": {
      "type": "string"
    },
    "index_version": {
      "type": "string"
    },
    "chars": {
      "type": "integer"
    },
    "budget": {
      "type": "object"
    },
    "warning": {
      "type": "string"
    }
  },
  "required": [
    "task",
    "delivery_state",
    "deterministic_authority",
    "deterministic_hash",
    "input_manifest",
    "manifest_hash",
    "input_hashes",
    "retrieved_intelligence",
    "packet_hash"
  ],
  "$defs": {
    "slot": {
      "enum": [
        "feature",
        "requirement",
        "decision",
        "scenario",
        "test_design",
        "interface",
        "architecture",
        "dataset",
        "evidence",
        "task_dependency",
        "other"
      ]
    },
    "manifest_entry": {
      "type": "object",
      "description": "One declared input of a task (Contract v3 W3 lines 1093-1098) and its deterministic resolution.",
      "properties": {
        "id": {
          "type": "string"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "required_status": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_state_class": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "version": {
              "type": "string"
            },
            "content_hash": {
              "type": "string"
            }
          }
        },
        "resolution": {
          "enum": [
            "RESOLVED",
            "ABSENT",
            "TYPE_MISMATCH"
          ]
        },
        "delivered": {
          "type": "boolean"
        },
        "satisfied": {
          "type": "boolean"
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "blocking"
            ]
          }
        }
      },
      "required": [
        "id",
        "slot",
        "required",
        "declared_in",
        "resolution",
        "delivered",
        "satisfied",
        "problems"
      ]
    },
    "task_input_declaration": {
      "type": "object",
      "description": "An entry of a task's required_inputs / optional_inputs list (the explicit task-input manifest).",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "slot name, list-field name or record type the input must satisfy"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "required_status": {
          "type": [
            "string",
            "array"
          ]
        },
        "required_state_class": {
          "type": [
            "string",
            "array"
          ]
        },
        "version": {
          "type": "string",
          "description": "exact version, '*', or comparators: =X >=X >X <=X <X ^X ~X"
        },
        "content_hash": {
          "type": "string",
          "description": "SHA-256 of the record bytes (or a prefix of at least 12 hex characters)"
        }
      },
      "required": [
        "id"
      ]
    },
    "delivered_input": {
      "type": "object",
      "description": "One mandatory input as delivered: identity, normative content and manifest annotation.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "content": {
          "type": "object"
        },
        "body": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_class": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_in": {
          "type": "array"
        },
        "authority_flag": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "content",
        "content_hash",
        "state_class",
        "required"
      ]
    },
    "consumption_receipt": {
      "type": "object",
      "description": "The worker's structured return is the consumption receipt (Contract v3 W5 lines 1114-1126). The worker-return schema's status is the report's outcome (context::receipt::report_from_worker_return is the lossless mapping).",
      "properties": {
        "context_packet_hash": {
          "type": "string"
        },
        "inputs_consumed": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+(@.+)?$"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "content_hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            ]
          }
        },
        "outputs_produced": {
          "type": "array"
        },
        "requirements_implemented": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenarios_implemented": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features_implemented": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "not_applicable_with_reason"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "test",
              "result"
            ]
          }
        },
        "deviations": {
          "type": "array"
        },
        "unresolved": {
          "type": "array"
        }
      },
      "required": [
        "context_packet_hash",
        "inputs_consumed",
        "outputs_produced",
        "deviations",
        "unresolved"
      ]
    }
  },
  "x-output-contracts": {
    "description": "Typed output -> input contracts (Contract v3 W2 lines 1082-1090: 'Output schemas define what downstream stages may consume'). For each governed output type: the task-input manifest slots (context::manifest::Slot) a downstream stage may consume it as. Authoritative slots (feature, requirement, decision, scenario, test_design, interface, architecture) additionally require the AUTHORITATIVE class unless the consuming task declares otherwise; every other slot delivers the output with its authority class and never as authority. A type not listed may be consumed only as evidence or other. context::manifest enforces exactly this table; the unit test output_contracts_in_the_schema_are_the_enforced_table pins it.",
    "output_contracts": {
      "feature": {
        "consumable_as": [
          "feature"
        ]
      },
      "requirement": {
        "consumable_as": [
          "requirement"
        ]
      },
      "decision": {
        "consumable_as": [
          "decision"
        ]
      },
      "scenario": {
        "consumable_as": [
          "scenario"
        ]
      },
      "test-obligation": {
        "consumable_as": [
          "test_design"
        ]
      },
      "interface": {
        "consumable_as": [
          "interface"
        ]
      },
      "architecture": {
        "consumable_as": [
          "architecture"
        ]
      },
      "data": {
        "consumable_as": [
          "dataset"
        ]
      },
      "task": {
        "consumable_as": [
          "task_dependency"
        ]
      },
      "*": {
        "consumable_as": [
          "evidence",
          "other"
        ],
        "downstream": "any governed output (research, experiment, report, audit, lesson, …) may be declared as derived_from evidence or as an explicit required input; it is delivered with its authority class and never promoted to authority"
      }
    }
  }
}
