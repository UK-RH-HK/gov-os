{
  "permissions": {
    "deny": [
      "Read(./docs/source/**)",
      "Edit(./docs/source/**)",
      "Edit(**/.env*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(config/secrets*)",
      "Bash(sudo:*)",
      "Read(//home/usain/gov-os-workbench/qualification-oracle/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/src\" python3 \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/pretooluse.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/src\" python3 \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/posttooluse.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/src\" python3 \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/posttooluse.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/precompact.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/sessionstart.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  }
}
