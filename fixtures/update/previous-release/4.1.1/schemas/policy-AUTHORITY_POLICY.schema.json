{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.2/policy-AUTHORITY_POLICY.schema.json",
  "title": "policy-AUTHORITY_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "AUTHORITY_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle_statuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_state_class_by_type": {
      "type": "object"
    },
    "retrieval_default_excludes_statuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_levels_required": {
      "type": "object"
    }
  },
  "required": [
    "policy",
    "version",
    "precedence",
    "state_classes",
    "lifecycle_statuses"
  ]
}
