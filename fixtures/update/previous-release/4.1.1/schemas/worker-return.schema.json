{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.2/worker-return.schema.json",
  "title": "worker-return",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "task": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "work_completed": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "object"
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_action": {
      "type": "string"
    }
  },
  "required": [
    "task",
    "status",
    "work_completed",
    "files_changed",
    "evidence",
    "tests",
    "discoveries",
    "risks",
    "lessons",
    "proposed_decisions",
    "unresolved",
    "recommended_next_action"
  ]
}
