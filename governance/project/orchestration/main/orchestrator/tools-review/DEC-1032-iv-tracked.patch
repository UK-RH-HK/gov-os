+    r = run(w)
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "seed of merged not applied" in r.stdout and "a normal rebuild" in r.stdout
+    assert prepares(w)[0][2] == []
+
+
+def test_without_the_integration_store_nothing_is_seeded(w):
