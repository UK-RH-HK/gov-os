+# How a shell's own options are read (ACT-GUARD-FIX-5, P1-GUARD-HEREDOC-OPTS-1: ``bash -euo pipefail <<EOF`` took the
+# option's value, pipefail, for a script file). Short letters of bash, dash and ksh that take no value, long options of
+# bash that take none, and the words that mean standard input as a script file. -o and -O (any place in a cluster)
+# and --rcfile and --init-file take the next word; any other option is unknown and reads the heredoc as shell.
+_SHELL_FLAGS = frozenset("abefhiklmnprstuvxBCDEHIPTV")
+_SHELL_LONG = frozenset(("--debugger", "--dump-po-strings", "--dump-strings", "--help", "--login", "--noediting",
+                         "--noprofile", "--norc", "--posix", "--pretty-print", "--restricted", "--verbose",
+                         "--version"))
+_SHELL_STDIN = frozenset(("-", "/dev/stdin", "/dev/fd/0", "/proc/self/fd/0"))
+
+
+def _shell_kind(args):
+    """How a shell reads a heredoc on its standard input, by its words: data when the program is in the words (-c) or
+    in a script file it is given; shell when it reads its program from the input (no script, -s, or a script named
+    ``-``, /dev/stdin or /dev/fd/0) or when an option is not one this knows (fail closed)."""
+    i, unknown, stdin, program = 0, False, False, False
+    while i < len(args):
+        a = args[i]
+        if a == "--":
+            i += 1
+            break
+        if a == "-":
+            break
+        if not a.startswith(("-", "+")):
+            break
+        if a.startswith("--"):
+            if a in ("--rcfile", "--init-file"):
+                i += 2
+                continue
+            unknown = unknown or a not in _SHELL_LONG
+            i += 1
+            continue
+        letters = a[1:]
+        if a[0] == "-" and "c" in letters:
+            program = True
+        elif any(x not in _SHELL_FLAGS and x not in "oO" for x in letters):
+            unknown = True
+        if a[0] == "-" and "s" in letters:
+            stdin = True
+        i += 1 + sum(letters.count(x) for x in "oO")
+    if program:
+        return "data"
+    # The last two tests are the earlier reading kept as a floor, so this never reads a heredoc as data that was read
+    # as shell before: -s anywhere in the words, and words that all start with -.
+    if unknown or stdin or i >= len(args) or args[i] in _SHELL_STDIN or "-s" in args or \
+            all(a.startswith("-") for a in args):
+        return "shell"
+    return "data"
+
