+        return False
+    if not tickets:
+        return True
+    if not ticket:
+        return False
+    from gov.guard import reads
+    names = set(reads._ticket(root, ticket)[0]) | set(reads._ticket(main, ticket)[0]) | {ticket}
+    return bool(names & set(tickets))
