+# ---- ACT-IDLE-GUARD-1: idle with headroom (11-11: ready.txt held one line, W2-170, its log used since 15:20; the tick
+# ran all afternoon with the gate open and no lead, and raised nothing)
+def headroom_items(w):
+    return sorted((w.d / "inbox").glob("*-idle-headroom*.txt"))
+
+
+def set_max_leads(w, n=3):
+    (w.d / "config.json").write_text(json.dumps({"max_leads": n}))
+
+
+def used_log_line(w, log="W2-A-A5-run1.json"):
+    """ready.txt holds only W2-A, whose log name was started long ago (past the stagger)."""
+    (w.d / "ready.txt").write_text(f"W2-A T-A A.md {log}\n")
+    (w.d / "started.txt").write_text(f"{datetime.fromtimestamp(NOW - 1000):%Y-%m-%d %H:%M:%S} W2-A A.md {log}\n")
+
+
+def test_idle_with_headroom_a_used_log_line_with_an_open_gate_raises_one_inbox_item_an_hour(w):
+    set_max_leads(w, 3)
+    used_log_line(w)
+    assert tick(w).returncode == 0 and calls(w) == []
+    items = headroom_items(w)
+    assert len(items) == 1
+    body = items[0].read_text()
+    assert body.startswith("log: dispatch.log\nIdle: headroom\nstatus: the gate is open and 0 of 3 leads run")
+    assert "skipped for a used or returned log: W2-A T-A (already started for W2-A-A5-run1.json)" in body
+    assert "new log name" in body and "DEC-1110" in body
+    assert not any(line.startswith("W2: ") for line in body.splitlines())    # that line would hold W2-A's own start
+    tick(w, DISPATCH_NOW=NOW + 600)
+    assert len(headroom_items(w)) == 1                                       # the same cause: once an hour
+    tick(w, DISPATCH_NOW=NOW + 3700)
+    assert len(headroom_items(w)) == 2
+    assert status(w)["ready_count"] == 1 and status(w)["max_leads"] == 3
+
+
+def test_idle_with_headroom_names_a_returned_log_and_an_empty_list(w):
+    set_max_leads(w, 3)
+    (w.orch / "log" / "W2-A-A5-run1.json").write_text(json.dumps({"result": "task: x\nstatus: DONE at abc\n"}))
+    (w.d / "ready.txt").write_text("W2-A T-A A.md W2-A-A5-run1.json\n")
+    tick(w)
+    assert "skipped for a used or returned log: W2-A T-A (W2-A-A5-run1.json already holds a return)" in \
+        headroom_items(w)[0].read_text()
+    w2_items = len(headroom_items(w))
+    (w.d / "ready.txt").write_text("")
+    tick(w, DISPATCH_NOW=NOW + 60)
+    assert len(headroom_items(w)) == w2_items + 1                             # another cause: reported at once
+    assert "0 line(s) in ready.txt" in headroom_items(w)[-1].read_text()
+
+
+def test_no_idle_item_when_a_line_starts_the_cap_is_reached_the_gate_is_shut_or_no_cap_is_set(w):
+    set_max_leads(w, 3)
+    tick(w)                                                                   # W2-A and W2-B are startable: one starts
+    assert calls(w) and headroom_items(w) == []
+    used_log_line(w)
+    set_max_leads(w, 1)
+    w.procs.write_text(json.dumps([{"cmd": LEAD.format("T-B"), "cwd": str(w.wt / "W2-B")}]))
+    tick(w, DISPATCH_NOW=NOW + 300)                                           # one of one lead runs: at the cap
+    assert headroom_items(w) == []
+    set_max_leads(w, 3)
+    tick(w, DISPATCH_NOW=NOW + 400, DISPATCH_GATE_CMD="sh -c 'echo SHUT load; exit 1'")
+    assert headroom_items(w) == []                                            # a legitimate wait
+    (w.d / "config.json").write_text("{}")
+    tick(w, DISPATCH_NOW=NOW + 500)
+    assert headroom_items(w) == []                                            # no cap set: the item is not sent
+    set_max_leads(w, 3)
+    tick(w, "--dry", DISPATCH_NOW=NOW + 600)
+    assert headroom_items(w) == []                                            # a dry pass writes nothing
+
+
+def test_a_cause_that_stops_holding_is_reported_again_when_it_returns(w):
+    set_max_leads(w, 3)
+    used_log_line(w)
+    tick(w)
+    assert len(headroom_items(w)) == 1
+    (w.d / "ready.txt").write_text("W2-B T-B B.md W2-B-A5-run2.json\n")      # a fresh line starts
+    tick(w, DISPATCH_NOW=NOW + 200)
+    assert calls(w) and json.loads((w.d / "idle-headroom-reported.json").read_text()) == {}
+    w.procs.write_text("[]")
+    used_log_line(w)
+    tick(w, DISPATCH_NOW=NOW + 400)
+    assert len(headroom_items(w)) == 2                                        # within the hour, but the cause had cleared
