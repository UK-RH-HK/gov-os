=== Appendix A: the trial's probe, as rehearsed (rerank_trial_probe.py; sha256 0dd9922e580dec4a)
#!/usr/bin/env python3
"""ACT-RERANK-TRIAL-1's probe: speaks the shared reranker's protocol ([query, [text, ...]] in, one JSON line out) to a
TRIAL service's socket only. Never starts a service.

  rerank_trial_probe.py SOCKET peak  [--limit MIB]   the padded bound's worst shapes, one at a time, GPU read before
                                                     and after each; stops at --limit (default 14255, the budget)
  rerank_trial_probe.py SOCKET load N [--limit MIB]  N clients at once, each sending a search's requests (3 of the
                                                     bound's shapes), as N searches at once would

Texts are cut from this repository's own visible files (code first, the densest in tokens), never from evaluation
fixtures. The client's answer timeout is the product's (GOV_RERANK_TIMEOUT_S, 30 s): a request past it is counted as
a search that would have gone unranked."""
import json, os, socket, statistics, subprocess, sys, threading, time

REPO = "/home/usain/Dynamic-Agentic-Engineering-OS"
SOURCES = [f"{REPO}/src/gov/retrieval/{n}" for n in ("retrieve.py", "semantic.py", "lexical.py", "fusion.py")]
BOUND, MAX_TEXTS = 24_000, 16  # the product's padded bound since b7085897 (count x longest pair) and its count cap
QUERY = "where does the reranker's request bound get applied and what does it count"
TIMEOUT = float(os.environ.get("GOV_RERANK_TIMEOUT_S", "30"))


def corpus() -> str:
    return "\n".join(open(p, encoding="utf-8").read() for p in SOURCES)


def shapes(text: str):
    """(name, texts): each at the bound, count x (len(query) + len(text)) <= 24,000."""
    out = []
    for count in (1, 2, 4, 8, 16):
        size = BOUND // count - len(QUERY)
        out.append((f"{count}x{size}", [text[i * 997 % (len(text) - size):][:size] for i in range(count)]))
    return out


def gpu_used():
    try:
        return int(subprocess.run(["nvidia-smi", "--query-gpu=memory.used", "--format=csv,noheader,nounits"],
                                  capture_output=True, text=True, timeout=10).stdout.split()[0])
    except Exception:
        return None


def ask(path: str, texts: list) -> tuple[float, str]:
    started = time.monotonic()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(2.0)
        try:
            s.connect(path)
        except OSError as error:
            return time.monotonic() - started, f"error: {error}"
        s.settimeout(TIMEOUT)
        s.sendall((json.dumps([QUERY, texts]) + "\n").encode())
        try:
            line = s.makefile("rb").readline()
        except socket.timeout:
            return time.monotonic() - started, "timeout"
        except OSError as error:
            return time.monotonic() - started, f"error: {error}"
    answer = json.loads(line) if line else {"error": "closed"}
    ok = "scores" in answer and len(answer["scores"]) == len(texts)
    return time.monotonic() - started, "ok" if ok else f"error: {answer.get('error')}"


def main(argv):
    path, mode = argv[1], argv[2]
    limit = int(argv[argv.index("--limit") + 1]) if "--limit" in argv else 14255
    text, cases = corpus(), None
    cases = shapes(text)
    if mode == "peak":
        for name, texts in cases:
            before = gpu_used()
            if before is not None and before >= limit:
                print(f"STOP before {name}: GPU {before} MiB >= {limit}"); return 3
            seconds, how = ask(path, texts)
            after = gpu_used()
            print(f"{name}: {how} in {seconds:.2f} s; GPU {before} -> {after} MiB")
            if after is not None and after >= limit:
                print(f"STOP after {name}: GPU {after} MiB >= {limit}"); return 3
        return 0
    n = int(argv[3])
    search = [cases[0][1], cases[2][1], cases[4][1]]  # one search: three requests of the bound's shapes, in turn
    times, outcomes, peak = [], [], [gpu_used() or 0]
    stop = threading.Event()

    def sample():
        while not stop.is_set():
            peak[0] = max(peak[0], gpu_used() or 0)
            time.sleep(1)

    def client():
        for texts in search:
            seconds, how = ask(path, texts)
            times.append(seconds); outcomes.append(how)

    sampler = threading.Thread(target=sample, daemon=True); sampler.start()
    started = time.monotonic()
    threads = [threading.Thread(target=client) for _ in range(n)]
    for t in threads: t.start()
    for t in threads: t.join()
    stop.set()
    wall = time.monotonic() - started
    bad = sum(1 for o in outcomes if o != "ok")
    if not times:
        print(f"load {n}: no request answered"); return 4
    q = statistics.quantiles(times, n=20) if len(times) > 1 else times * 19
    print(f"load {n}: {len(times)} requests in {wall:.1f} s; per request p50 {statistics.median(times):.2f} s, "
          f"p95 {q[18]:.2f} s, max {max(times):.2f} s; not ok {bad} (timeouts {outcomes.count('timeout')}); "
          f"GPU peak {peak[0]} MiB")
    return 0 if bad == 0 and peak[0] < limit else 4


if __name__ == "__main__":
    sys.exit(main(sys.argv))

=== Appendix B: the rehearsal's stand-in server (standin_server.py; rehearsal only, never used in the trial)
#!/usr/bin/env python3
"""REHEARSAL ONLY: a stand-in for the reranker service's protocol, no model, no GPU, no torch. One connection at a
time (as the service), [query, [text, ...]] in, {"scores": [...], "device": "standin"} out after SECONDS_PER_REQUEST.
  standin_server.py SOCKET SECONDS_PER_REQUEST"""
import json, os, socket, sys, time

path, per = sys.argv[1], float(sys.argv[2])
if os.path.lexists(path):
    os.unlink(path)
mask = os.umask(0o177)
listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
listener.bind(path)
os.umask(mask)
listener.listen(128)
print("READY standin", flush=True)
while True:
    connection, _ = listener.accept()
    with connection:
        try:
            query, texts = json.loads(connection.makefile("rb").readline())
            time.sleep(per)
            connection.sendall((json.dumps({"scores": [0.0] * len(texts), "device": "standin"}) + "\n").encode())
        except OSError:
            pass  # the caller gave up (as rerank_service.serve)

=== Appendix C: the trial copy of rerank_worker.py, whole (the pin's file with R5's diff; sha256 9beb9e4b3457c1f4); rerank_service.py is the pin's unchanged (sha256 49d544c8bb4c8bfc)
"""The reranker's own process (W1-19; ADR-0002 §2, DEC-397). Started by ``gov.retrieval.rerank``, never imported
except by ``rerank_service.py``, which shares ``take_slot``, ``load`` and ``scores``.

It runs in the reranker environment, loads the pinned model once, and then answers one line with one line until
its caller closes the pipe: ``[query, [text, …]]`` in, ``[score, …]`` out, as JSON. The first line it writes says
the model is loaded and on which device (``{"device": ...}``); a process that ends without it has no model, and its
reason is on standard error.

The GPU slot rule (DEC-1033, W2-112): before torch or the model loads, the worker holds one of
``GOV_RERANK_GPU_SLOTS`` (default 2) lock files ``gov-os-rerank-gpu-<n>.lock`` in ``GOV_RERANK_GPU_LOCK_DIR`` (default
/tmp) for its life, waiting for one up to ``GOV_RERANK_GPU_WAIT_S`` (default 20) seconds; without one it ends named
(exit 75). It never hides the GPU to run on the CPU: a GPU already hidden ends it named (exit 76), and so does a
machine where torch sees no GPU at all (exit 78, after the slot, before the model loads), unless
``GOV_RERANK_ALLOW_CPU=1`` (tests and measurements only). While the interim module ``gov_reranker_gpu_slot`` is
installed it has already taken a slot in this process (``GOV_RERANK_GPU_SLOT``), and the worker takes nothing more.
"""

import json
import os
import sys
import time

NO_SLOT, GPU_HIDDEN, NO_GPU = 75, 76, 78
_HELD = []  # the slot's lock file, open for the process's life


def gpu_present() -> bool:
    """True when torch sees a CUDA GPU; any failure to ask is no GPU."""
    try:
        import torch

        return bool(torch.cuda.is_available())
    except Exception:
        return False


def take_slot(allow_cpu: bool):
    """None when this process may load its model, holding a GPU slot for its life (or, with ``allow_cpu``, on the
    CPU); otherwise ``(exit code, reason)``. The shared service calls it too, never allowing the CPU (DEC-1036)."""
    import fcntl

    if os.environ.get("GOV_RERANK_GPU_SLOT"):
        return None  # the interim module holds one for this process
    if os.environ.get("CUDA_VISIBLE_DEVICES") in ("-1", ""):
        return None if allow_cpu else (GPU_HIDDEN, "the GPU is hidden from it (CUDA_VISIBLE_DEVICES), and no "
                                                   "reranker runs on the CPU")
    slots, wait = int(os.environ.get("GOV_RERANK_GPU_SLOTS", "2")), float(os.environ.get("GOV_RERANK_GPU_WAIT_S", "20"))
    if not 0 <= wait < float("inf"):
        raise ValueError("GOV_RERANK_GPU_WAIT_S must be a finite number of seconds")
    folder, deadline = os.environ.get("GOV_RERANK_GPU_LOCK_DIR", "/tmp"), time.monotonic() + wait
    while True:
        for i in range(slots):
            fd = os.open(os.path.join(folder, f"gov-os-rerank-gpu-{i}.lock"), os.O_CREAT | os.O_RDWR, 0o600)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(fd)
                continue
            _HELD.append(fd)
            os.environ["GOV_RERANK_GPU_SLOT"] = str(i)
            return None
        if allow_cpu:  # the old fallback, for tests only
            os.environ["CUDA_VISIBLE_DEVICES"] = "-1"
            return None
        if time.monotonic() >= deadline:
            return NO_SLOT, f"no GPU slot free within {wait:g} s"
        time.sleep(min(1.0, max(0.0, deadline - time.monotonic())))


def load(model: str, revision: str, device: str | None = None):
    """The pinned cross-encoder; ``device`` None is the library's choice (the GPU when there is one), as before.
    TRIAL (ACT-RERANK-TRIAL-1, never the live service): ``GOV_RERANK_TRIAL_8BIT=1`` loads it in 8-bit (bitsandbytes
    LLM.int8, on GPU 0)."""
    from sentence_transformers import CrossEncoder

    extra = {}
    if os.environ.get("GOV_RERANK_TRIAL_8BIT") == "1":
        from transformers import BitsAndBytesConfig

        extra["model_kwargs"] = {"quantization_config": BitsAndBytesConfig(load_in_8bit=True), "device_map": {"": 0}}
    # The snapshot's own configuration carries the instruction and the yes/no scoring.
    return CrossEncoder(model, revision=revision, **({"device": device} if device else {}), **extra)


def scores(encoder, query: str, texts: list) -> list:
    """TRIAL: each request's own peak (PyTorch's reserved memory) and time on standard error (the service's log), and
    the cache released after it (window 4's form) unless ``GOV_RERANK_TRIAL_RELEASE=0`` (today's live behaviour)."""
    import torch

    torch.cuda.reset_peak_memory_stats()
    started = time.monotonic()
    out = [float(score) for score in encoder.predict([(query, text) for text in texts])]
    seconds, peak = time.monotonic() - started, torch.cuda.max_memory_reserved() >> 20
    if os.environ.get("GOV_RERANK_TRIAL_RELEASE", "1") == "1":
        torch.cuda.empty_cache()
    padded = len(texts) * max((len(query) + len(text) for text in texts), default=0)
    print(json.dumps({"trial": "request", "texts": len(texts), "padded_chars": padded, "seconds": round(seconds, 3),
                      "peak_reserved_mib": peak, "reserved_after_mib": torch.cuda.memory_reserved() >> 20}),
          file=sys.stderr, flush=True)
    return out


def device_of(encoder) -> str | None:
    return str(getattr(encoder, "device", "") or "") or None


def main(model: str, revision: str) -> None:
    answers, sys.stdout = sys.stdout, sys.stderr  # whatever the libraries print stays out of the answers
    allow_cpu = os.environ.get("GOV_RERANK_ALLOW_CPU") == "1"
    refused = take_slot(allow_cpu)
    if not refused and not allow_cpu and not gpu_present():  # no GPU at all: never the CPU (DEC-1033, DEC-1036)
        refused = NO_GPU, "no GPU is available to it, and no reranker runs on the CPU"
    if refused:
        print(f"gov reranker: {refused[1]}; this search goes without reranking", file=sys.stderr, flush=True)
        sys.exit(refused[0])
    encoder = load(model, revision)
    print(json.dumps({"device": device_of(encoder)}), file=answers, flush=True)
    for line in sys.stdin:
        query, texts = json.loads(line)
        print(json.dumps(scores(encoder, query, texts)), file=answers, flush=True)


if __name__ == "__main__":
    main(*sys.argv[1:3])

