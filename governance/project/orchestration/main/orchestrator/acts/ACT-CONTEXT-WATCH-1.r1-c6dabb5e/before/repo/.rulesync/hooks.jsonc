{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse.py\"; g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH, so $h cannot run; refused\" >&2; exit 2; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h cannot run; refused\" >&2; exit 2; }; \"$p\" -E \"$h\"; r=$?; case $r in 0|2) exit $r;; esac; echo \"gov hook: $h ended with exit $r (it could not run or crashed); refused\" >&2; exit 2",
        "timeout": 60
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" -E \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/precompact.py\"",
        "timeout": 60
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "matcher": "compact|clear|resume",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" -E \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/sessionstart.py\"",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" -E \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/stop.py\"",
        "timeout": 60
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no pinned gov at $HOME/.local/bin/gov or on PATH\" >&2; exit 1; }; read -r p < \"$g\"; p=\"${p#'#!'}\"; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" -E \"$CLAUDE_PROJECT_DIR/template/governance/kernel/hooks/subagentstop.py\"",
        "timeout": 60
      }
    ]
  }
}
