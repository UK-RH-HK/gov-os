@@ -39,6 +39,29 @@ CTO_WBS = "W2-00"  # the coordination ticket whose orchestrator session is the C
 INLINE_CODE = re.compile(r"\b(python3?|perl|node|ruby)\s+(-\w*\s+)*-[cei]\b")
 
 
+def inline_writes_acceptance(command):
+    """Rule 1 for inline interpreter code (DEC-958, ACT-GUARD-FIX-2): each simple command of ``command`` is judged
+    alone (split at ; && || | and newlines, quotes kept), and one is refused only when it holds inline code and names
+    the acceptance tests itself. A command that cannot be split (unbalanced quotes) is judged whole, as before."""
+    import shlex
+    try:
+        lex = shlex.shlex(command, posix=True, punctuation_chars=";&|\n")
+        lex.whitespace_split = True
+        lex.whitespace = " \t\r"
+        lex.commenters = ""
+        parts, cur = [], []
+        for tok in lex:
+            if tok and set(tok) <= set(";&|\n"):
+                parts.append(" ".join(cur))
+                cur = []
+            else:
+                cur.append(tok)
+        parts.append(" ".join(cur))
+    except ValueError:
+        parts = [command]
+    return any(INLINE_CODE.search(part) and ACCEPTANCE in part for part in parts)
+
