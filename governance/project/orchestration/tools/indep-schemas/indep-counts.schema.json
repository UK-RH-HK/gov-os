{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "indep-counts.schema.json",
  "title": "What returns to the CTO from one independent session's launch: counts and digests only (LAUNCH-SPEC \u00a74, W2-149). Every object closed, every string a const, an enum or an anchored pattern: no free text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "act",
    "kind",
    "run",
    "set",
    "round",
    "commit",
    "brief_sha256",
    "approved_sha256",
    "seed_sha256",
    "template_ok",
    "override",
    "selection",
    "session",
    "out",
    "delivered",
    "traces",
    "status",
    "code",
    "reason"
  ],
  "properties": {
    "act": {
      "type": "string",
      "const": "ACT-INDEP-WALLS-1"
    },
    "kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "writer",
        "checker",
        "auditor",
        "labeller",
        null
      ]
    },
    "run": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*-r[12]$"
    },
    "set": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "round": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        1,
        2,
        null
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "brief_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "template_ok": {
      "type": "boolean"
    },
    "override": {
      "type": "boolean"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "sample",
        "overlap"
      ],
      "properties": {
        "changed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sample": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "overlap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit",
        "is_error",
        "turns",
        "cost_usd",
        "duration_s",
        "refusals"
      ],
      "properties": {
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "is_error": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "refusals": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "Read",
            "Grep",
            "Glob",
            "Write",
            "Edit",
            "MultiEdit",
            "TodoWrite",
            "Bash",
            "WebFetch",
            "WebSearch",
            "Task",
            "Agent",
            "NotebookEdit",
            "Skill",
            "other"
          ],
          "properties": {
            "Read": {
              "type": "integer",
              "minimum": 0
            },
            "Grep": {
              "type": "integer",
              "minimum": 0
            },
            "Glob": {
              "type": "integer",
              "minimum": 0
            },
            "Write": {
              "type": "integer",
              "minimum": 0
            },
            "Edit": {
              "type": "integer",
              "minimum": 0
            },
            "MultiEdit": {
              "type": "integer",
              "minimum": 0
            },
            "TodoWrite": {
              "type": "integer",
              "minimum": 0
            },
            "Bash": {
              "type": "integer",
              "minimum": 0
            },
            "WebFetch": {
              "type": "integer",
              "minimum": 0
            },
            "WebSearch": {
              "type": "integer",
              "minimum": 0
            },
            "Task": {
              "type": "integer",
              "minimum": 0
            },
            "Agent": {
              "type": "integer",
              "minimum": 0
            },
            "NotebookEdit": {
              "type": "integer",
              "minimum": 0
            },
            "Skill": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ok",
        "files",
        "questions",
        "by_kind",
        "by_area",
        "checked",
        "accepted",
        "revise",
        "rejected",
        "misses",
        "labelled",
        "allow",
        "refuse",
        "agree",
        "disagree"
      ],
      "properties": {
        "schema_ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "questions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "by_kind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "fact": {
              "type": "integer",
              "minimum": 0
            },
            "procedure": {
              "type": "integer",
              "minimum": 0
            },
            "decision": {
              "type": "integer",
              "minimum": 0
            },
            "location": {
              "type": "integer",
              "minimum": 0
            },
            "negative": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_area": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "contract": {
              "type": "integer",
              "minimum": 0
            },
            "decisions": {
              "type": "integer",
              "minimum": 0
            },
            "kernel": {
              "type": "integer",
              "minimum": 0
            },
            "code": {
              "type": "integer",
              "minimum": 0
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            },
            "operations": {
              "type": "integer",
              "minimum": 0
            },
            "docs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "checked": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "accepted": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "revise": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rejected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "misses": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "gold_wrong": {
              "type": "integer",
              "minimum": 0
            },
            "question_ambiguous": {
              "type": "integer",
              "minimum": 0
            },
            "retrieval_miss": {
              "type": "integer",
              "minimum": 0
            },
            "answer_wrong": {
              "type": "integer",
              "minimum": 0
            },
            "out_of_scope": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "labelled": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "allow": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "refuse": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "agree": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disagree": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "delivered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "sha256",
        "to"
      ],
      "properties": {
        "files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "set",
            "notes",
            "classes",
            "labels",
            null
          ]
        }
      }
    },
    "traces": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "delivered",
        "rejected",
        "refused",
        "stopped",
        "dry"
      ]
    },
    "code": {
      "type": "integer",
      "enum": [
        0,
        10,
        11,
        12,
        13,
        14,
        15,
        16,
        17,
        20,
        21,
        22
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "brief",
        "template",
        "wall_exists",
        "seed_order",
        "commit",
        "file_budget",
        "canary",
        "argument",
        "result",
        "stopped",
        "trace",
        null
      ]
    }
  }
}
