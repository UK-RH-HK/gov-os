    def test_no_file_a_plain_run_reads_for_its_configuration_or_collection_changes():
        known = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--verify", "--quiet", BASE_BRANCH],
                               capture_output=True, text=True)
        if known.returncode != 0:
