    def _ran_with(run, expected, why):
        """Each test of ``expected`` (``{id: result}``) ran in this run (the told log) and is labelled with that result
        in ``test_cache.tests[]``, never ``reused`` and never left out."""
        problems = []
        for test_id, result in expected.items():
            label = run.result_of(test_id)
            if test_id not in run.labels:
                problems.append(f"{test_id} is not in the record at all (expected `{result}`)")
            elif not run.ran.get(test_id):
                problems.append(f"{test_id} did not run in this run; the record says {label!r} (expected `{result}`)")
            elif label != result:
                problems.append(f"{test_id} ran; the record says {label!r} (expected `{result}`)")
