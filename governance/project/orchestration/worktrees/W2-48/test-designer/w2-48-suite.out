    def test_entries_of_a_close_whose_tree_holds_an_untracked_input_are_ignored_by_the_next_close(
            tmp_path, sandbox, interface, told):
        extra = {
            ".gitignore": support.GITIGNORE + "src/pkg/local_*.py\n",
