{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research",
  "description": "Frontmatter of a research record.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/frontmatter" }],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/record_id" },
    "type": { "const": "research" },
    "sources": { "description": "The ids the research cites (DEC-1073); optional.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decisions": { "description": "The decisions the research feeds (DEC-1073); optional.", "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
