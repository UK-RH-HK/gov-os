{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "madr",
  "description": "Frontmatter of a MADR decision record: an ADR file in git (DEC-012).",
  "allOf": [{ "$ref": "common.schema.json#/$defs/frontmatter" }],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/decision_id" },
    "type": { "const": "decision" },
    "depends_on": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/decision_id" } },
    "implements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constrains": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
