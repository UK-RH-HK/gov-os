{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/pretooluse.py\"",
        "timeout": 60
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/posttooluse.py\"",
        "timeout": 60
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/posttooluse.py\"",
        "timeout": 60
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/sessionstart.py\"",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/stop.py\"",
        "timeout": 60
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/precompact.py\"",
        "timeout": 60
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/subagentstop.py\"",
        "timeout": 60
      }
    ]
  }
}
