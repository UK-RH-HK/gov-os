{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/pretooluse.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h cannot run; refused\" >&2; exit 2; }; \"$p\" -E \"$h\"; r=$?; case $r in 0|2) exit $r;; esac; echo \"gov hook: $h ended with exit $r (it could not run or crashed); refused\" >&2; exit 2",
        "timeout": 60
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/posttooluse.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h cannot run; refused\" >&2; exit 2; }; \"$p\" -E \"$h\"; r=$?; case $r in 0|2) exit $r;; esac; echo \"gov hook: $h ended with exit $r (it could not run or crashed); refused\" >&2; exit 2",
        "timeout": 60
      },
      {
        "type": "command",
        "matcher": "Bash",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/context_watch.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p\" >&2; exit 1; }; exec \"$p\" -E \"$h\"",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/posttooluse.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h cannot run; refused\" >&2; exit 2; }; \"$p\" -E \"$h\"; r=$?; case $r in 0|2) exit $r;; esac; echo \"gov hook: $h ended with exit $r (it could not run or crashed); refused\" >&2; exit 2",
        "timeout": 60
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "matcher": "compact|clear|resume",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/sessionstart.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h was not run\" >&2; exit 0; }; exec \"$p\" -E \"$h\"",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/stop.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h was not run\" >&2; exit 0; }; exec \"$p\" -E \"$h\"",
        "timeout": 60
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/precompact.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h was not run\" >&2; exit 0; }; exec \"$p\" -E \"$h\"",
        "timeout": 60
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/subagentstop.py\"; c=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; g=\"$c/gov/bin/gov\"; [ -n \"$c\" ] && [ -f \"$g\" ] || g=\"$HOME/.local/bin/gov\"; [ -f \"$g\" ] || g=\"$(command -v gov)\" || { echo \"gov hook: no gov at ${c:-(no git repository)}/gov/bin/gov, $HOME/.local/bin/gov or on PATH, so $h was not run\" >&2; exit 0; }; { read -r p; read -r q; } < \"$g\"; p=\"${p#'#!'}\"; [ \"$p\" != /bin/sh ] || { q=\"${q#\"'''exec' \"}\"; q=\"${q%' \"$0\" \"$@\"'}\"; q=\"${q#\\\"}\"; p=\"${q%\\\"}\"; }; [ -x \"$p\" ] || { echo \"gov hook: $g names no interpreter that runs: $p, so $h was not run\" >&2; exit 0; }; exec \"$p\" -E \"$h\"",
        "timeout": 60
      }
    ]
  }
}
