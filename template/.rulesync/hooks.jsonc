{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/pretooluse.py\"; python3 \"$h\"; r=$?; case $r in 0|2) exit $r;; esac; echo \"gov hook: $h ended with exit $r (it could not run or crashed); refused\" >&2; exit 2",
        "timeout": 60
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/posttooluse.py\"; python3 \"$h\"; r=$?; case $r in 0|2) exit $r;; esac; echo \"gov hook: $h ended with exit $r (it could not run or crashed); refused\" >&2; exit 2",
        "timeout": 60
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "h=\"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/posttooluse.py\"; python3 \"$h\"; r=$?; case $r in 0|2) exit $r;; esac; echo \"gov hook: $h ended with exit $r (it could not run or crashed); refused\" >&2; exit 2",
        "timeout": 60
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/sessionstart.py\"",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/stop.py\"",
        "timeout": 60
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/precompact.py\"",
        "timeout": 60
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/governance/kernel/hooks/subagentstop.py\"",
        "timeout": 60
      }
    ]
  }
}
