 },
 "rules": {
  "build": [
   "target/**",
   "**/target/**",
   ".claude/worktrees/**",
   "**/__pycache__/**",
   "**/*.pyc",
   "**/.pytest_cache/**",
   "**/.governance-runtime/**",
   "build/**",
   "dist/**",
   "**/*.egg-info/**",
   "release/evidence/tmp/**"
  ],
  "max_text_bytes": 1048576,
  "secret_content": [
   "aws-access-key",
   "aws-secret-key",
   "generic-api-key",
   "github-token",
   "jwt",
   "password-assignment",
   "private-key-block",
