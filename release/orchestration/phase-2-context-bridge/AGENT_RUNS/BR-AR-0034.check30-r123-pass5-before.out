                moved["done"] = True
                moved["new_commit"] = _move_records_ref(built_repo.root)
            return real_cite_identifier(*args, **kwargs)
    
        monkeypatch.setattr(lintmod.citemod, "cite_identifier", _cite_and_move_once)
    
