"""Runtime loader for the assistant rules and the chat answer cache (legacy behaviour kept alive)."""
import sqlite3

RULES_PATH = ".cursorrules"
CHAT_DB = "memory/chat_history.sqlite"


def load_rules() -> str:
    with open(RULES_PATH) as f:
        return f.read()


def recent_answers():
    return sqlite3.connect(CHAT_DB).execute("select content from messages where role='assistant'").fetchall()

