      detail: {"code": "GATE_PACKAGE_INCOMPLETE", "details": {"invalid": ["confidence must be a number in [0, 1]"], "missing": [], "non_substantive_values": ["", "not assessed", "unassessed", "tbd", "todo", "?", "-", "...", "unknown"], "required_fields": ["question", "why_now", "current_state", "options", "impact", "reversibility", "cost_rework", "recommendation", "confidence", "permitted_next_actions"]}, "message": "a Human Decision Gate is raised only with a complete decision package (Contract v3 L2; HUMAN_GATE_POLICY.decision_package_fields). Missing: []. Invalid: [\"confidence must be a number in [0, 1]\"]. Supply them in --fields; nothing is defaulted to 'not assessed'."}

