========================================
=== R2: Chat-memory retirement ===
========================================
--- adopt extract (A8) handles legacy memory stores ---
The adopt module (runtime/src/adopt.rs) includes a8_extract_legacy which:
  - Inventories legacy memory stores
  - Extracts unique decisions/lessons
  - Creates PROVISIONAL records with provenance
  - Archives the source stores
  - Registers LEG-0001 as HISTORICAL

========================================
=== R3: Archive Policy ===
========================================
--- ARCHIVE_POLICY from kernel ---
policy: ARCHIVE_POLICY
version: 1.0.0
archive_root: archive
archive_subdirs: [governance, spec, research, code-reference]
archive_when: [historical_governance, superseded_spec_with_reference_value, research_of_lasting_value, deliberate_reference_implementation]
do_not_archive: [dead_source_files_without_reference_value]
unused_code_action: remove_from_active_tree   # Git preserves history
default_retrieval_for_archive: false
archive_mutation: restricted

--- Repository contract archive path ---
  archive: archive/
paths:
- pattern: governance/kernel/**
  class: authoritative
  owner_role: release-agent
  mutation: prohibited
--
- pattern: archive/**
  class: historical
  owner_role: orchestrator
  default_retrieval: false
  mutation: restricted
  semantic_index: false

