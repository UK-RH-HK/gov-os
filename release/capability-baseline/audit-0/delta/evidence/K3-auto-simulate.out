=== K3: Automatic impact simulation for material triggers ===
--- CHANGE_POLICY.auto_simulate_triggers ---
auto_simulate_triggers: [architecture_change, behaviour_change, interface_change, security_change, governance_change, infrastructure_cost, acceptance_criteria_change, data_migration]
human_gate_triggers: [architecture_change, security_change, governance_change, infrastructure_cost, data_migration, acceptance_criteria_change]

--- Test each trigger type ---
  trigger=architecture_change:
    auto_simulated=True
  trigger=behaviour_change:
    auto_simulated=True
  trigger=interface_change:
    auto_simulated=True
  trigger=security_change:
    auto_simulated=True
  trigger=governance_change:
    auto_simulated=True
  trigger=infrastructure_cost:
    auto_simulated=True
  trigger=acceptance_criteria_change:
