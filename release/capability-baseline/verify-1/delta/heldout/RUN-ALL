#!/usr/bin/env bash
# P2-AR-0049 — run every held-out probe of capability family delta and print one PASS/FAIL line per test.
#
#   ./RUN-ALL                 run every probe, writing each probe's full output to ../evidence/<probe>.out
#   DELTA_RUN=<tag> ./RUN-ALL use a distinct set of scenario machines (each run gets its own; nothing is deleted,
#                             because `rm` is denied in the verification environment)
#
# Requirements: a release build of the candidate at <worktree>/target/release/gov (CARGO_BUILD_JOBS=2
# ~/.cargo/bin/cargo build --release), python3 with `cryptography` and `pyyaml`, git.
set -u
cd "$(dirname "$0")"
HERE="$(pwd)"; EV="$(cd "$HERE/.." && pwd)/evidence"
mkdir -p "$EV"
export DELTA_RUN="${DELTA_RUN:-$(date +%s)}"

PROBES="J-research-experiment.sh D-prior-findings.sh K12-cit-p-and-e.sh K34-materiality-and-radius.sh L12-contradictions-and-package.sh L34-presentation-and-blocking.sh M-model-routing.sh N-checkpoints-and-handoffs.sh X-crosscutting.sh"

TOTAL_P=0; TOTAL_F=0; FAILED=""
for p in $PROBES; do
  echo "================================================================ $p"
  out="$EV/${p%.sh}.out"
  bash "$p" > "$out" 2>&1
  grep -E '^(PASS|FAIL) ' "$out"
  line="$(grep -E '^---- ' "$out" | tail -1)"
  echo "$line"
  pn="$(echo "$line" | sed -n 's/.*: \([0-9]*\) passed.*/\1/p')"; fn="$(echo "$line" | sed -n 's/.*, \([0-9]*\) failed.*/\1/p')"
  TOTAL_P=$((TOTAL_P + ${pn:-0})); TOTAL_F=$((TOTAL_F + ${fn:-0}))
  [ "${fn:-0}" != 0 ] && FAILED="$FAILED $p"
done
echo "================================================================"
echo "P2-AR-0049 held-out suite (family delta): $TOTAL_P passed, $TOTAL_F failed"
[ -n "$FAILED" ] && echo "probes with failures:$FAILED"
echo "full output per probe: $EV/<probe>.out"
exit 0
