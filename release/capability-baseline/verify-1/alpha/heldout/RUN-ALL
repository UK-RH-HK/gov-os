#!/usr/bin/env bash
# P2-AR-0046 (verify-1, family alpha) — re-run every held-out probe and print one PASS/FAIL
# line per check, then a per-suite summary.
#
#   ./RUN-ALL                 run every suite
#   ./RUN-ALL t02 t05         run the named suites only
#
# Preconditions
#   * a release build of the product under verification:   CARGO_BUILD_JOBS=2 cargo build --release
#   * python3 with `cryptography` and `PyYAML`             (the verifier's own ed25519 signer)
#   * a writable scratch area (default below, override with ALPHA_SCRATCH)
#
# These probes are the VERIFIER's independent evidence. They are never part of the product tree
# and are never run by the product's own suites. Every signature they present to `gov` is made by
# `lib/srrsign.py` (python-`cryptography`), not by the product's `tests/certification/srr_material.rs`.
#
# Checks that are EXPECTED to fail on cap2-candidate-1 are the findings of this verification; see
# ../findings.yaml. RUN-ALL exits non-zero while any check fails, so a later candidate that closes
# them all exits 0.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ALPHA_SCRATCH="${ALPHA_SCRATCH:-/tmp/claude-1000/-home-usain-Dynamic-Agentic-Engineering-OS/1b6c780e-2b37-439f-a969-a8d96b7ad35e/scratchpad/alpha}"
mkdir -p "$ALPHA_SCRATCH"

suites=(
  "t01_a2_root_of_trust.py"
  "t02_cross_machine.py"
  "t03_gate_a.py"
  "t04_adopt_roles.py"
  "t05_release_init_update.py"
  "t06_gate_b_contract_freshness.py"
)

if [ "$#" -gt 0 ]; then
  sel=()
  for want in "$@"; do
    for s in "${suites[@]}"; do
      case "$s" in "$want"*) sel+=("$s") ;; esac
    done
  done
  suites=("${sel[@]}")
fi

rc=0
declare -a summary
for s in "${suites[@]}"; do
  echo "===== ${s%.py} :: $here/$s ====="
  out="$ALPHA_SCRATCH/${s%.py}.runall.out"
  python3 "$here/$s" 2>&1 | tee "$out"
  st=${PIPESTATUS[0]}
  pass=$(grep -c '^PASS ' "$out" || true)
  fail=$(grep -c '^FAIL ' "$out" || true)
  summary+=("${s%.py}: $pass passed, $fail failed (exit $st)")
  [ "$st" -ne 0 ] && rc=1
done

echo
echo "===== RUN-ALL summary ====="
for line in "${summary[@]}"; do echo "$line"; done
exit "$rc"
