#!/usr/bin/env bash
# Gamma (P2-AR-0048) iteration-1 held-out suite — Governance OS Phase 2, candidate cap2-candidate-1.
#
# These are INDEPENDENT held-out tests: written by the verifier from Contract v3 and the product's
# observable behaviour, never copied from builder tests or builder probes, and never added to the
# product tree. They drive `target/release/gov` against disposable projects on ISOLATED simulated
# machines (one XDG_STATE_HOME per project), so no probe touches the real machine's governance state.
#
# Usage:
#   GAMMA_WT=<verification worktree> [GAMMA_LAB=<scratch dir>] bash RUN-ALL
#
# Requirements: the release binary at $GAMMA_WT/target/release/gov, python3 with pyyaml and
# `cryptography` (the owner-side Ed25519 signer that stands in for the product owner; published test
# seeds only — the gov binary holds no signing key).
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
export GAMMA_WT="${GAMMA_WT:-$(cd "$HERE/../../../../.." && pwd)}"
export GAMMA_LAB="${GAMMA_LAB:-/tmp/gamma-verify1-lab-$$}"
echo "worktree: $GAMMA_WT"
echo "lab:      $GAMMA_LAB"
[ -x "$GAMMA_WT/target/release/gov" ] || { echo "FAIL  no gov binary at $GAMMA_WT/target/release/gov (cargo build --release)"; exit 2; }
"$GAMMA_WT/target/release/gov" --version

PROBES="
E1-E2-authority.sh
E3-E4-handoff-claims.sh
F1-F2-F5-skills-tools-layers.sh
F3-F4-tool-install-gate.sh
F4-plugin-boundary.sh
G1-G2-I1-I4-command-work.sh
H1-H4-spec-readiness.sh
FRESHNESS-invalidation.sh
OD-P2-01-human-approval.sh
PRIOR-FINDINGS-recheck.sh
V1-F4-01-executed-proof.sh
"
tp=0; tf=0; failed=""
for p in $PROBES; do
  echo; echo "==================== $p ===================="
  out=$(bash "$HERE/$p" 2>&1)
  printf '%s\n' "$out" | grep -E '^(PASS|FAIL|    )'
  line=$(printf '%s\n' "$out" | grep -E '^---- ' | tail -1)
  echo "$line"
  pp=$(printf '%s' "$line" | sed -n 's/.*: \([0-9]*\) passed.*/\1/p'); ff=$(printf '%s' "$line" | sed -n 's/.*, \([0-9]*\) failed.*/\1/p')
  tp=$((tp + ${pp:-0})); tf=$((tf + ${ff:-0}))
  [ "${ff:-0}" != "0" ] && failed="$failed $p"
done
echo
echo "================================================================"
echo "GAMMA HELD-OUT SUITE: $tp passed, $tf failed"
[ -n "$failed" ] && echo "probes with failures:$failed"
echo "A FAIL is a recorded observation of the candidate's behaviour, not a harness error:"
echo "see 00-VERIFICATION-REPORT.md and findings.yaml for what each one falsifies."
exit 0
