#!/usr/bin/env bash
# Re-run every held-out probe of family zeta (Gate W), verification iteration 1, run P2-AR-0051.
#
#   ZETA_WT   the worktree holding the candidate (default: five levels up from this script)
#   ZETA_GOV  the gov binary (default: $ZETA_WT/target/release/gov)
#   ZETA_WORK scratch root for the disposable repositories (default: $TMPDIR/zeta-v1-work)
#
# Each probe builds its own disposable governed repository under ZETA_WORK, on its own simulated
# machine (XDG_STATE_HOME), and prints one PASS/FAIL line per check. Nothing is written into the
# product tree. Requires: git, python3 (PyYAML; jsonschema optional), and a built `gov`.
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ZETA_WT="${ZETA_WT:-$(cd "$here/../../../../.." && pwd)}"
export ZETA_GOV="${ZETA_GOV:-$ZETA_WT/target/release/gov}"
export ZETA_WORK="${ZETA_WORK:-${TMPDIR:-/tmp}/zeta-v1-work}"
mkdir -p "$ZETA_WORK"

if [ ! -x "$ZETA_GOV" ]; then
  echo "FAIL RUN-ALL  gov binary not found at $ZETA_GOV (build it: CARGO_BUILD_JOBS=2 cargo build --release)"
  exit 2
fi

probes=(
  w01_identity.py
  w01b_plan_bench.py
  w02_contracts.py
  w03_manifest.py
  w04_delivery.py
  w05_receipt.py
  w06_staleness.py
  w07_orphans.py
  w08_lineage.py
  w09_continuity.py
  w10_hard_invariant.py
  w11_metrics.py
  w12_tiers.py
)

rc=0
for p in "${probes[@]}"; do
  echo "==== $p"
  python3 "$here/$p" || rc=1
done

echo "==== RUN-ALL finished (exit $rc)"
exit $rc
