{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/task.schema.json",
  "title": "task",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "task"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "class": {
      "type": "string",
      "enum": [
        "discovery",
        "research",
        "experiment",
        "specification",
        "decision-preparation",
        "data",
        "architecture",
        "implementation",
        "integration",
        "test-design",
        "test-execution",
        "security",
        "devops",
        "performance",
        "validation",
        "refactor",
        "repair",
        "documentation",
        "release",
        "tooling",
        "memory",
        "governance",
        "migration"
      ]
    },
    "task_status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "BLOCKED",
        "CLAIMED",
        "IN_PROGRESS",
        "REVIEW",
        "DONE",
        "CANCELLED",
        "WAITING_HUMAN"
      ]
    },
    "feature": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "READ_REPO",
          "WRITE_REPO_SCOPED",
          "RUN_TESTS",
          "NETWORK_READ",
          "NETWORK_WRITE",
          "PACKAGE_INSTALL",
          "SYSTEM_INSTALL",
          "DB_READ",
          "DB_WRITE",
          "CLOUD_READ",
          "CLOUD_WRITE",
          "CI_TRIGGER",
          "SECRET_READ",
          "DEPLOY_STAGING",
          "DEPLOY_PRODUCTION"
        ]
      }
    },
    "minimum_model_tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "minimum_reasoning": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "extra_high"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production_merge_allowed": {
      "type": "boolean"
    },
    "human_gate": {
      "type": "string"
    },
    "readiness_cell": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "retest_required": {
      "type": "boolean"
    },
    "claim": {
      "type": "object"
    },
    "closed_by_report": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "estimate": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "class",
    "task_status",
    "objective"
  ]
}
