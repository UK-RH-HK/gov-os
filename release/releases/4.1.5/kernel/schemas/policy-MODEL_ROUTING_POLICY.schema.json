{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/policy-MODEL_ROUTING_POLICY.schema.json",
  "title": "policy-MODEL_ROUTING_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "MODEL_ROUTING_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "tiers": {
      "type": "object"
    },
    "reasoning_levels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_class_minimum_tier": {
      "type": "object"
    },
    "radius_minimum_tier": {
      "type": "object"
    },
    "record_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "policy",
    "version",
    "tiers",
    "task_class_minimum_tier"
  ]
}
