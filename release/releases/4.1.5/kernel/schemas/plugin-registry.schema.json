{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/plugin-registry.schema.json",
  "title": "plugin-registry",
  "x-schema-version": "1.0.0",
  "type": "object",
  "description": "Authoritative record of capability-plugin registrations, written only by `gov plugins register`. Binds plugin identity, version, descriptor bytes and implementation bytes to the governed act that registered them.",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "plugins": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "plugin_id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "number"
            ]
          },
          "descriptor_path": {
            "type": "string"
          },
          "descriptor_sha256": {
            "type": "string"
          },
          "implementation_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "implementation_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_permission_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "object"
          },
          "registration_gate": {
            "type": [
              "string",
              "null"
            ]
          },
          "registered_by_session": {
            "type": "string"
          },
          "registered_by_role": {
            "type": "string"
          },
          "registered_at": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        },
        "required": [
          "plugin_id",
          "capability",
          "version",
          "descriptor_sha256",
          "registered_at",
          "registered_by_role"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "plugins"
  ]
}
