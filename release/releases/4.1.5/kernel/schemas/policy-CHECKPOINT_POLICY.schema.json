{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/policy-CHECKPOINT_POLICY.schema.json",
  "title": "policy-CHECKPOINT_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "CHECKPOINT_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mandatory_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watchdog": {
      "type": "object"
    },
    "location": {
      "type": "string"
    },
    "prose_summary_as_checkpoint": {
      "const": "prohibited"
    }
  },
  "required": [
    "policy",
    "version",
    "fields",
    "mandatory_triggers",
    "location"
  ]
}
