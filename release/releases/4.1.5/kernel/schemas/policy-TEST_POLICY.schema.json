{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/policy-TEST_POLICY.schema.json",
  "title": "policy-TEST_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "TEST_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "product_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governance_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independent_test_author_required_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_task_requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "green_record_currency": {
      "type": "string"
    },
    "task_close_requires_tests_status": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "policy",
    "version",
    "governance_families"
  ]
}
