{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.5/human-gate.schema.json",
  "title": "human-gate",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
    },
    "type": {
      "const": "human-gate"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "LEGACY",
        "HISTORICAL",
        "REJECTED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE",
        "DERIVED",
        "NARRATIVE",
        "EVIDENCE",
        "HISTORICAL",
        "UNKNOWN_OR_CONFLICTING"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "IMPLEMENTS",
              "REALISES",
              "GOVERNED_BY",
              "CONSTRAINS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "VALIDATED_BY",
              "TESTS",
              "USES",
              "PRODUCES",
              "CONSUMES",
              "AFFECTS",
              "GENERATED_FROM",
              "CALLS",
              "IMPORTS",
              "OWNS",
              "FAILED_BECAUSE",
              "LEARNED_FROM"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "staleness": {
      "type": "object"
    },
    "legacy_source": {
      "type": "string"
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PRESENTED",
        "ANSWERED",
        "EXPIRED",
        "WITHDRAWN"
      ]
    },
    "question": {
      "type": "string"
    },
    "why_now": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "impact": {
      "type": "string"
    },
    "reversibility": {
      "type": "string"
    },
    "cost_rework": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "permitted_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presented_in_chat": {
      "type": "boolean"
    },
    "presented_at": {
      "type": "string"
    },
    "answer": {
      "type": "object"
    },
    "priority_score": {
      "type": "number"
    },
    "trigger": {
      "type": "string"
    },
    "cit": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "gate_status",
    "question"
  ]
}
