{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.4/policy-MEMORY_POLICY.schema.json",
  "title": "policy-MEMORY_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "MEMORY_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "runtime_dir": {
      "type": "string"
    },
    "memory_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "embedding": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "dimensions": {
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "version"
      ]
    },
    "reranker": {
      "type": "object"
    },
    "chunking": {
      "type": "object"
    },
    "retrieval": {
      "type": "object"
    },
    "freshness": {
      "type": "object"
    },
    "regression": {
      "type": "object"
    },
    "rebuild": {
      "type": "object"
    },
    "namespaces": {
      "type": "object"
    }
  },
  "required": [
    "policy",
    "version",
    "runtime_dir",
    "embedding",
    "chunking",
    "retrieval",
    "freshness",
    "regression"
  ]
}
