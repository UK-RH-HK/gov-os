{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.4/data-sensitivity.schema.json",
  "title": "data-sensitivity",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "default_class": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ]
    },
    "identifiers_to_strip": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "class": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted",
              "secret"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "pattern",
          "class"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "default_class"
  ]
}
