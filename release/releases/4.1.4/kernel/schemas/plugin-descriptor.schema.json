{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.4/plugin-descriptor.schema.json",
  "title": "plugin-descriptor",
  "x-schema-version": "1.1.0",
  "type": "object",
  "properties": {
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 2
    },
    "capability": {
      "type": "string",
      "enum": [
        "embed",
        "rerank",
        "code_intel",
        "ecosystem",
        "secret_scan"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "version": {
      "type": [
        "string",
        "number"
      ],
      "description": "identity/version pin; the implementation's content hash is recorded per version (drift is refused)"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "roles that may trigger execution ('all' = every role); absent = roles at/above TOOL_POLICY.plugins.min_authority for hand-declared descriptors"
    },
    "required_permission_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "network": {
          "type": "boolean"
        },
        "filesystem_write": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "health_check": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "command_exists",
            "protocol_ping",
            "command"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "pin": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "registered_by_session": {
          "type": "string"
        },
        "registered_by_role": {
          "type": "string"
        },
        "registered_at": {
          "type": "string"
        },
        "gate": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "registration_gate": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string"
    }
  },
  "required": [
    "plugin_id",
    "capability",
    "command",
    "version"
  ],
  "additionalProperties": false
}
