{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.4/policy-ARCHIVE_POLICY.schema.json",
  "title": "policy-ARCHIVE_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "ARCHIVE_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "archive_root": {
      "type": "string"
    },
    "archive_subdirs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "archive_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_archive": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unused_code_action": {
      "type": "string"
    },
    "default_retrieval_for_archive": {
      "type": "boolean"
    },
    "archive_mutation": {
      "type": "string"
    }
  },
  "required": [
    "policy",
    "version",
    "archive_root"
  ]
}
