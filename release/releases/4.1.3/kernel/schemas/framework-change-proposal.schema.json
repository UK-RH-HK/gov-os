{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.3/framework-change-proposal.schema.json",
  "title": "framework-change-proposal",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FCP-[0-9]{4}$"
    },
    "type": {
      "const": "framework-change-proposal"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROVISIONAL",
        "ACTIVE",
        "REJECTED",
        "SUPERSEDED",
        "RETIRED"
      ]
    },
    "state_class": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "cluster_key": {
      "type": "string"
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_projects": {
      "type": "integer"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "critical_defect",
        "cross_project_repeat",
        "repeated_low_level",
        "single_lesson"
      ]
    },
    "release_action": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "problem_statement": {
      "type": "string"
    },
    "generic_failure_mode": {
      "type": "string"
    },
    "suggested_framework_change": {
      "type": "string"
    },
    "evidence_strength": {
      "type": "array"
    },
    "next": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "status",
    "trigger",
    "release_action",
    "packets"
  ]
}
