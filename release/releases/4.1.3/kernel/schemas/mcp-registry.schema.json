{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.2/mcp-registry.schema.json",
  "title": "mcp-registry",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{1,6}-[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "enum": [
              "stdio",
              "http",
              "sse"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_permission_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "READ_REPO",
                "WRITE_REPO_SCOPED",
                "RUN_TESTS",
                "NETWORK_READ",
                "NETWORK_WRITE",
                "PACKAGE_INSTALL",
                "SYSTEM_INSTALL",
                "DB_READ",
                "DB_WRITE",
                "CLOUD_READ",
                "CLOUD_WRITE",
                "CI_TRIGGER",
                "SECRET_READ",
                "DEPLOY_STAGING",
                "DEPLOY_PRODUCTION"
              ]
            }
          },
          "approved_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "credential_scope": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "health": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "transport",
          "capabilities",
          "approved_roles",
          "status"
        ]
      }
    }
  },
  "required": [
    "version",
    "servers"
  ]
}
