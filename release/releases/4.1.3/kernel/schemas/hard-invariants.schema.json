{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.2/hard-invariants.schema.json",
  "title": "hard-invariants",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-\\d{3}$"
          },
          "name": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "enforced_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "statement"
        ]
      }
    }
  },
  "required": [
    "version",
    "invariants"
  ]
}
