{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.2/index-manifest.schema.json",
  "title": "index-manifest",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "index_version": {
      "type": "string"
    },
    "embedder": {
      "type": "object"
    },
    "reranker": {
      "type": "object"
    },
    "chunking": {
      "type": "object"
    },
    "repo_commit": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "counts": {
      "type": "object"
    },
    "manifest_hash": {
      "type": "string"
    },
    "built_at": {
      "type": "string"
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "index_version",
    "embedder",
    "artifacts",
    "counts",
    "manifest_hash"
  ]
}
