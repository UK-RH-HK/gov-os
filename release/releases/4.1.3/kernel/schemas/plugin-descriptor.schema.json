{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.3/plugin-descriptor.schema.json",
  "title": "plugin-descriptor",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "plugin_id": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "enum": [
        "embed",
        "rerank",
        "code_intel",
        "ecosystem",
        "secret_scan"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "version": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "plugin_id",
    "capability",
    "command"
  ]
}
