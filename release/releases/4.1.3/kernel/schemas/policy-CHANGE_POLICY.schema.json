{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.2/policy-CHANGE_POLICY.schema.json",
  "title": "policy-CHANGE_POLICY",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "policy": {
      "const": "CHANGE_POLICY"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "impact_radii": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_approve_max_radius": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "auto_simulate_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gate_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "radius_rules": {
      "type": "object"
    },
    "graph_traversal_depth_by_radius": {
      "type": "object"
    },
    "semantic_candidates_by_radius": {
      "type": "object"
    },
    "propagation": {
      "type": "object"
    },
    "verification_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "object"
    }
  },
  "required": [
    "policy",
    "version",
    "auto_approve_max_radius",
    "human_gate_triggers",
    "radius_rules"
  ]
}
