{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.2/roles.schema.json",
  "title": "roles",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "authority_levels": {
      "type": "object"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4",
              "L5"
            ]
          },
          "minimum_tier": {
            "type": "string"
          },
          "default_reasoning": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "level"
        ]
      }
    }
  },
  "required": [
    "version",
    "authority_levels",
    "roles"
  ]
}
