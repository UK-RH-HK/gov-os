 "D_design": {
  "01_TA_5_prime": [
   "| TA-5\u2032 | (Restated in revision 6.) The operator performs the first-contact procedure over the sources the owner's OP-13 answer names, reading each now (`32` FC-1\u2026FC-3), and types the state fingerprint from an independent channel for human anchors and in-gate proofs | first admission (under the stated first-contact root, `32` \u00a76); OP-6; human anchors |"
  ],
  "06_s3_step0": [
   "| 0 | FC-1: read the first-contact code from each OP-13 source; FC-2: `sha256sum` of the manifest equals the code; FC-3: `sha256sum` of `gov-admit` equals the manifest's entry for the target (under (c) also the platform signature) | the operator's platform tools (`gov trust fc-procedure` prints the steps) | evaluator selection through the agreed code (the first-contact root) |"
  ],
  "09_header_fc_procedure": [
   ">   `gov trust fc-procedure` prints the procedure for the owner's OP-13 answer."
  ],
  "24_C0_row_names_fc_procedure": false,
  "31_GB_1_prime_C0_without_record": true,
  "31_TB_1_prime": [
   "| TB-1\u2032 | A malicious binary run directly, outside admission, ignores every rule | GB rules bind genuine binaries, including revoked ones; the documented procedure never runs a candidate | FA6 S1 (FA5 `DA04`) |"
  ],
  "32_FC_R2_bound": [
   "| FC-R2 (TA-5/A10) | An operator who types one source's value for every required source | inside FC-R1 (`op1src`); the procedure prints each source's name and requires its page | RT-156 |"
  ],
  "32_s4_fc_procedure": [
   "`certutil -hashfile`) and, under OP-13 (c), the platform's signature verification. `gov trust fc-procedure` prints these steps"
  ],
  "any_rule_on_where_the_operator_obtains_the_designation_or_procedure": [],
  "plan_rows_substituting_the_designation_or_procedure_printer": []
 },
