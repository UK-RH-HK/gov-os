  "run P1r4 $O/P1r4-project-strength-and-absence.json $P/evidence $E REVIEW_REPO=$R GOV_REVIEW_SCRATCH=$S/p1r4 GOV=$L/gov-4.1.5 python3 -B P1r4-project-strength-and-absence.py",
