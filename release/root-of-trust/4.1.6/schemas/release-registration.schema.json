{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os/schemas/release-registration/1",
  "title": "Release Registration Statement payload (RoT-1 revision 5, PROPOSED; 30 \u00a75)",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "trust_root_id",
    "release_id",
    "sequence",
    "final_statement_digest",
    "candidate_statement_digest",
    "source",
    "inputs_manifest_digest",
    "targets",
    "verification_records",
    "constitution",
    "migrations",
    "issued_at"
  ],
  "properties": {
    "_type": {
      "const": "https://agentic-engineering-os/statement/release-registration/v1"
    },
    "trust_root_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "final_statement_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_statement_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_commit",
        "content_digest"
      ],
      "properties": {
        "release_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 over sorted '<mode> <path> <sha256 of blob>' lines of the whole tree (30 \u00a74.1)"
        }
      }
    },
    "inputs_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "verification_records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_tree_digest",
        "units"
      ],
      "properties": {
        "kernel_tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "units": {
          "type": "object",
          "description": "unit id (leaf:<key> | members:<key> | file:<path>) -> exactly one value: a digest, or the sorted member-id list",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            ]
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "admitter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "binary_digests": {
      "type": "object",
      "description": "OP-9 (d) only: target -> digest of the custodians' own reproduction",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "lowering_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "reason"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
