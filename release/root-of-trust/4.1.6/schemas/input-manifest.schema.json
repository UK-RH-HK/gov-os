{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os/schemas/input-manifest/2",
  "title": "Build-input manifest v2 (unsigned; digest registered; RoT-1 revision 6, PROPOSED; 30 §4.2, 33 §3)",
  "x-schema-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "toolchain",
    "lockfile_sha256",
    "build_profile",
    "targets",
    "environments"
  ],
  "properties": {
    "schema": {
      "const": "governance-os.input-manifest/2"
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "archive_sha256",
          "upstream_checksum_reference"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "upstream_checksum_reference": {
            "type": "string"
          }
        }
      }
    },
    "lockfile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "build_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remap_path_prefixes",
        "profile",
        "flags"
      ],
      "properties": {
        "remap_path_prefixes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "environment_id",
          "environment_tree_digest",
          "supplier_class"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "environment_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "environment_tree_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "supplier_class": {
            "type": "string",
            "pattern": "^[A-Z]$"
          }
        }
      }
    }
  }
}
