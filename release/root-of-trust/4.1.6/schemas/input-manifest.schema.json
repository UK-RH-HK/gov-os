{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os/schemas/input-manifest/1",
  "title": "Build-input manifest (unsigned; digest registered; RoT-1 revision 5, PROPOSED; 30 \u00a74.2)",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "toolchain",
    "lockfile_sha256",
    "build_image_digest",
    "build_profile",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "governance-os.input-manifest/1"
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "archive_sha256",
          "upstream_checksum_reference"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "upstream_checksum_reference": {
            "type": "string"
          }
        }
      }
    },
    "lockfile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "build_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "build_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remap_path_prefixes",
        "profile",
        "flags"
      ],
      "properties": {
        "remap_path_prefixes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
