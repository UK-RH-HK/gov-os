{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os/schemas/input-manifest/3",
  "title": "Build-input manifest v3 (unsigned; digest registered; RoT-1 revision 7, CP-1, PROPOSED; 30 §4.2, 33)",
  "x-schema-version": "3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_profile",
    "environment_lock_digest",
    "lockfile_sha256",
    "schema",
    "targets",
    "toolchains"
  ],
  "properties": {
    "schema": {
      "const": "governance-os.input-manifest/3"
    },
    "toolchains": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "archive_sha256",
          "compiler_version",
          "toolchain_id"
        ],
        "properties": {
          "toolchain_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "compiler_version": {
            "type": "string",
            "maxLength": 128
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "description": "OP-10 (b): at least two toolchain lineages registered in the root-signed toolchain registry; independence computed from provenance"
    },
    "lockfile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "build_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flags",
        "linking",
        "profile",
        "remap_path_prefixes"
      ],
      "properties": {
        "remap_path_prefixes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linking": {
          "const": "static-self-contained"
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+-[a-z0-9_]+-[a-z0-9_]+(-[a-z0-9_]+)?$"
      }
    }
  }
}
