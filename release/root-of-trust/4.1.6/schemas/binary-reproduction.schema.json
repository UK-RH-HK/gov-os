{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os/schemas/binary-reproduction/2",
  "title": "Binary reproduction statement payload v2 (RoT-1 revision 6, PROPOSED; 30 §7, 33 R-BENV-4). Exactly one reproducer signature per envelope.",
  "x-schema-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "trust_root_id",
    "release_id",
    "source",
    "inputs_manifest_digest",
    "target",
    "binary_digest",
    "tbm_digest",
    "environment_id",
    "reproduced_at"
  ],
  "properties": {
    "_type": {
      "const": "https://agentic-engineering-os/statement/binary-reproduction/v2"
    },
    "trust_root_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "release_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_commit",
        "git_tree",
        "content_digest"
      ],
      "properties": {
        "release_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "governance-os.source-content-digest/2: SHA-256 over length-prefixed (mode, path, blob SHA-256) records of the commit's tree, paths with control characters refused (30 §4.1, revision 6)"
        }
      }
    },
    "inputs_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "string"
    },
    "binary_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tbm_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reproduced_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "the registered environment the reproducer re-assembled (33 R-BENV-4)"
    }
  }
}
