{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.6/constitutional-surface-inventory.schema.json",
  "title": "constitutional-surface-inventory",
  "description": "PROPOSED (RoT-1 revision 4). Constitutional Surface Inventory: the surface section of the Trust Policy (23). Default deny; closed floor vocabulary (floor_schema_version 3, floor-ops/3); presence (required files and leaves; absence refused, 23 \u00a73.5); exact precedence registration (23 \u00a74.1); the Overlay Surface with directions and migration-writable targets (23 \u00a711); owner constitutional domain slots (23 \u00a77.2).",
  "x-schema-version": "3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "csi_version",
    "status",
    "floor_schema_version",
    "default",
    "precedence",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "governance-os.constitutional-surface-inventory"
    },
    "schema_version": {
      "const": 2
    },
    "csi_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string"
    },
    "floor_schema_version": {
      "const": 3
    },
    "default": {
      "const": "deny"
    },
    "derived_from": {
      "type": "object"
    },
    "vocabulary": {
      "type": "object"
    },
    "precedence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "rules"
      ],
      "properties": {
        "default_mode": {
          "enum": [
            "immutable",
            "floor",
            "ceiling",
            "additive",
            "shrink_only",
            "strengthen_only_bool",
            "overridable"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "mode"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "immutable",
                  "floor",
                  "ceiling",
                  "additive",
                  "shrink_only",
                  "strengthen_only_bool",
                  "overridable"
                ]
              },
              "kind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "order": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "strict_value": {},
              "exception_relaxable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "never_exception_relaxable_prefixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "glob": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "structured",
              "pinned_file",
              "transaction_input",
              "informational_file"
            ]
          },
          "name": {
            "type": "string"
          },
          "policy_file": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          },
          "collections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "id_field"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "id_field": {
                  "type": "string"
                },
                "rationale": {
                  "type": "string"
                }
              }
            }
          },
          "leaves": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "class"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "class": {
                  "enum": [
                    "floor",
                    "pinned",
                    "members",
                    "precedence",
                    "release_bound",
                    "project_tunable",
                    "informational",
                    "collection_id",
                    "covered_by_collection"
                  ]
                },
                "op": {
                  "enum": [
                    "level_at_least",
                    "level_at_most",
                    "ordered_at_least",
                    "ordered_at_most",
                    "decimal_at_least",
                    "decimal_at_most",
                    "set_superset",
                    "set_subset",
                    "bool_toward",
                    "equals",
                    "ids_equal",
                    "ids_subset",
                    "ids_superset"
                  ]
                },
                "value": {},
                "kind": {
                  "type": "string"
                },
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "strict": {
                  "type": "boolean"
                },
                "digests": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "registered": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rationale": {
                  "type": "string"
                },
                "subtree": {
                  "type": "boolean"
                },
                "statement_field": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "precedence_rule": {
                  "type": "string"
                },
                "presence": {
                  "enum": [
                    "required",
                    "optional"
                  ]
                },
                "absent_rationale": {
                  "type": "string"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "class": {
                        "const": "floor"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "op",
                      "value"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "class": {
                        "const": "pinned"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "digests"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "class": {
                        "const": "members"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "op",
                      "registered"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "class": {
                        "enum": [
                          "informational",
                          "release_bound"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "rationale"
                    ]
                  }
                }
              ]
            }
          },
          "digests": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "presence": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "absent_rationale": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "glob"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "structured"
                }
              }
            },
            "then": {
              "required": [
                "name",
                "leaves"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "pinned_file"
                }
              }
            },
            "then": {
              "required": [
                "digests"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "enum": [
                    "transaction_input",
                    "informational_file"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "rationale"
              ]
            }
          }
        ]
      }
    },
    "overlay_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "files"
      ],
      "properties": {
        "default": {
          "const": "deny"
        },
        "sensitivity_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "glob": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "direction"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "direction": {
                      "enum": [
                        "add",
                        "applicable_superset",
                        "classification_superset",
                        "contract_at_least",
                        "effective_policy",
                        "entries_subset",
                        "equal",
                        "map_subset",
                        "none",
                        "remove",
                        "strict_true",
                        "up"
                      ]
                    },
                    "migration_writable": {
                      "type": "boolean"
                    },
                    "subtree": {
                      "type": "boolean"
                    },
                    "order": {}
                  }
                }
              },
              "file_direction": {},
              "migration_add_from_template": {},
              "rationale": {}
            },
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "glob"
                ]
              }
            ]
          }
        }
      }
    },
    "owner_domain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "presence",
          "consumers"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "presence": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "mode": {
            "type": "string"
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "registration": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "binding_group": {
            "type": "string",
            "minLength": 1,
            "description": "owner-domain binding group confirmed and pinned as one set (23 \u00a77.2)"
          }
        }
      }
    }
  }
}
