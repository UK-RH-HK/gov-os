{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os/schemas/admission-record/2",
  "title": "Local admission record v2 (never signed; RoT-1 revision 6, PROPOSED; 31 R-ADM-7′). Held only inside the verifier trust store as vts-<lineage prefix>/admissions/<binary digest>.json; a record anywhere else is ignored (GB-1′).",
  "x-schema-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binary_digest",
    "target",
    "release_id",
    "lineage",
    "first_contact_code",
    "admitted_at",
    "admitter_digest",
    "valid_until",
    "location_protected"
  ],
  "properties": {
    "schema": {
      "const": "governance-os.admission-record/2"
    },
    "binary_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "lineage": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "admitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "admitter_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "location_protected": {
      "type": "boolean"
    },
    "first_contact_code": {
      "type": "string",
      "pattern": "^gov-fc:[0-9a-f]{8}:[0-9]+:[0-9a-f]{64}$",
      "description": "the code agreed across the OP-13 sources (32 §3)"
    }
  }
}
