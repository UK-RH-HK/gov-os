{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.6/dsse-envelope.schema.json",
  "title": "dsse-envelope",
  "description": "PROPOSED (RoT-1 revision 2). Structural envelope checks only; purpose, signature, canonical form, lineage, profile and source context are 05 SV-1..SV-10.",
  "x-schema-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "properties": {
    "payloadType": {
      "enum": [
        "application/vnd.agentic-engineering-os.trust-root.v2+json",
        "application/vnd.agentic-engineering-os.trust-policy.v1+json",
        "application/vnd.agentic-engineering-os.trust-state.v1+json",
        "application/vnd.agentic-engineering-os.release-final.v1+json",
        "application/vnd.agentic-engineering-os.release-candidate.v1+json",
        "application/vnd.agentic-engineering-os.artifact-final.v1+json",
        "application/vnd.agentic-engineering-os.artifact-candidate.v1+json",
        "application/vnd.agentic-engineering-os.verification-attestation.v1+json",
        "application/vnd.agentic-engineering-os.certification-status.v1+json",
        "application/vnd.agentic-engineering-os.revocation.v2+json",
        "application/vnd.agentic-engineering-os.historical-identity.v1+json",
        "application/vnd.agentic-engineering-os.retrieval-profile.v1+json"
      ]
    },
    "payload": {
      "type": "string",
      "description": "standard padded base64 of the canonical payload bytes; <= 4 MiB decoded",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "maxLength": 5592408
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyid",
          "sig"
        ],
        "properties": {
          "keyid": {
            "$ref": "#/$defs/keyid"
          },
          "sig": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{86}==$"
          }
        }
      }
    }
  },
  "$defs": {
    "keyid": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{64}$"
    }
  }
}
