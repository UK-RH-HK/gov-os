{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-engineering-os/4.1.6/trust-base-manifest.schema.json",
  "title": "trust-base-manifest",
  "description": "PROPOSED (RoT-1 revision 3). Trust Base Manifest compiled into every gov binary (25 §4). Signed components are named by digest; compiled code is covered by the build attestation.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "framework",
    "trust_profile",
    "binary",
    "lineage",
    "root_chain",
    "trust_policy",
    "trust_state",
    "embedded_release",
    "compiled_rules"
  ],
  "properties": {
    "_type": {
      "const": "https://agentic-engineering-os/manifest/trust-base/v1"
    },
    "framework": {
      "const": "agentic-engineering-os"
    },
    "trust_profile": {
      "enum": [
        "production",
        "test"
      ]
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "target",
        "build",
        "source_commit",
        "build_inputs_digest",
        "toolchain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "target": {
          "type": "string",
          "maxLength": 128
        },
        "build": {
          "enum": [
            "release",
            "development"
          ]
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "build_inputs_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toolchain": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "lineage": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "root_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "statement_digest"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "statement_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "trust_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "statement_digest"
      ],
      "properties": {
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "statement_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "trust_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "statement_digest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "statement_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "embedded_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_statement_digest",
        "tree_digest"
      ],
      "properties": {
        "release_statement_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "compiled_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_schema_version",
        "operator_vocabulary",
        "purpose_table_digest",
        "statement_schemas_digest",
        "format_readers",
        "command_register_digest"
      ],
      "properties": {
        "floor_schema_version": {
          "const": 2
        },
        "operator_vocabulary": {
          "const": "floor-ops/2"
        },
        "purpose_table_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "statement_schemas_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "format_readers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "command_register_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
