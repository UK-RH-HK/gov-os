{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os/schemas/environment-lock/1",
  "title": "Environment lock (registered source content at release/build/ENVIRONMENT_LOCK.json; RoT-1 revision 7, CP-1, PROPOSED; 33 §3)",
  "x-schema-version": "1.0.0",
  "description": "Per certified target and supplier class: the components an environment contains and where each is placed. No recipe, no inline content, no checksum-key reference: keys come only from the root-signed supplier registry, and assembly (gov-envassemble/1) only places component bytes. The lock is source: a change is reviewed by both verifiers and registered with the source identity (33 R-BENV-7″).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environments",
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "governance-os.environment-lock/1"
    },
    "environments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "components",
          "supplier_id",
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9_]+-[a-z0-9_]+-[a-z0-9_]+(-[a-z0-9_]+)?$"
          },
          "supplier_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "name",
                "placement_path",
                "sha256",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "placement_path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._/-]+$",
                  "maxLength": 1024
                },
                "mode": {
                  "enum": [
                    420,
                    493
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
